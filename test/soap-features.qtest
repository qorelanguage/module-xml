#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# SOAP Features Tests - Copyright (C) 2026 Qore Technologies, s.r.o.
# Comprehensive tests for advanced SOAP/WSDL features:
# - Multi-dimensional SOAP arrays
# - Multipart/related binding
# - URL replacement deserialization
# - HTTP binding fault codes
# - Multiref processing improvements
#
# Includes: positive tests, corner cases, negative tests, round-trip tests

%requires qore >= 2.3
%modern

%requires QUnit
%requires ../qlib/WSDL.qm
%requires ../qlib/SoapHandler.qm
%requires Mime
%requires xml

%exec-class SoapFeaturesTest

class SoapFeaturesTest inherits QUnit::Test {
    public {
        WebService ws;
    }

    private {
        # Comprehensive Test WSDL
        const TestWsdl = '<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:http="http://schemas.xmlsoap.org/wsdl/http/"
             xmlns:mime="http://schemas.xmlsoap.org/wsdl/mime/"
             xmlns:tns="http://test.example.com/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/"
             targetNamespace="http://test.example.com/"
             name="NewFeaturesTestService">

  <types>
    <xsd:schema targetNamespace="http://test.example.com/">
      <!-- Multi-dimensional array types -->
      <xsd:complexType name="Matrix2D">
        <xsd:complexContent>
          <xsd:restriction base="soapenc:Array">
            <xsd:attribute ref="soapenc:arrayType" wsdl:arrayType="xsd:int[,]" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"/>
          </xsd:restriction>
        </xsd:complexContent>
      </xsd:complexType>

      <xsd:complexType name="Matrix3D">
        <xsd:complexContent>
          <xsd:restriction base="soapenc:Array">
            <xsd:attribute ref="soapenc:arrayType" wsdl:arrayType="xsd:string[,,]" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"/>
          </xsd:restriction>
        </xsd:complexContent>
      </xsd:complexType>

      <xsd:complexType name="NestedArray">
        <xsd:complexContent>
          <xsd:restriction base="soapenc:Array">
            <xsd:attribute ref="soapenc:arrayType" wsdl:arrayType="xsd:int[][]" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"/>
          </xsd:restriction>
        </xsd:complexContent>
      </xsd:complexType>

      <xsd:complexType name="StringMatrix">
        <xsd:complexContent>
          <xsd:restriction base="soapenc:Array">
            <xsd:attribute ref="soapenc:arrayType" wsdl:arrayType="xsd:string[,]" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"/>
          </xsd:restriction>
        </xsd:complexContent>
      </xsd:complexType>

      <xsd:complexType name="MatrixRequest">
        <xsd:sequence>
          <xsd:element name="matrix" type="tns:Matrix2D"/>
          <xsd:element name="name" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="MatrixResponse">
        <xsd:sequence>
          <xsd:element name="result" type="tns:Matrix2D"/>
          <xsd:element name="sum" type="xsd:int"/>
        </xsd:sequence>
      </xsd:complexType>

      <!-- For URL replacement tests -->
      <xsd:complexType name="UserRequest">
        <xsd:sequence>
          <xsd:element name="userId" type="xsd:string"/>
          <xsd:element name="action" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="UserResponse">
        <xsd:sequence>
          <xsd:element name="status" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <!-- For multipart tests -->
      <xsd:complexType name="DocumentRequest">
        <xsd:sequence>
          <xsd:element name="title" type="xsd:string"/>
          <xsd:element name="content" type="xsd:base64Binary"/>
        </xsd:sequence>
      </xsd:complexType>

      <!-- For anyAttribute tests: structured content plus anyAttribute, which allows a
           scalar to be supplied for the type and wrapped as "^value^" -->
      <xsd:complexType name="AnyAttrSeqType">
        <xsd:sequence>
          <xsd:element name="part" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
        <xsd:attribute name="lang" type="xsd:string"/>
        <xsd:anyAttribute namespace="##other" processContents="skip"/>
      </xsd:complexType>

      <!-- the same shape without anyAttribute: a scalar must be rejected -->
      <xsd:complexType name="StrictSeqType">
        <xsd:sequence>
          <xsd:element name="part" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
    </xsd:schema>
  </types>

  <message name="processMatrixInput">
    <part name="request" type="tns:MatrixRequest"/>
  </message>
  <message name="processMatrixOutput">
    <part name="response" type="tns:MatrixResponse"/>
  </message>

  <message name="getUserInput">
    <part name="userId" type="xsd:string"/>
    <part name="action" type="xsd:string"/>
  </message>
  <message name="getUserOutput">
    <part name="status" type="xsd:string"/>
  </message>

  <message name="getResourceInput">
    <part name="category" type="xsd:string"/>
    <part name="id" type="xsd:string"/>
    <part name="format" type="xsd:string"/>
  </message>
  <message name="getResourceOutput">
    <part name="data" type="xsd:string"/>
  </message>

  <message name="uploadDocInput">
    <part name="title" type="xsd:string"/>
    <part name="attachment" type="xsd:base64Binary"/>
  </message>
  <message name="uploadDocOutput">
    <part name="docId" type="xsd:string"/>
  </message>

  <portType name="NewFeaturesPortType">
    <operation name="processMatrix">
      <input message="tns:processMatrixInput"/>
      <output message="tns:processMatrixOutput"/>
    </operation>
    <operation name="getUser">
      <input message="tns:getUserInput"/>
      <output message="tns:getUserOutput"/>
    </operation>
    <operation name="getResource">
      <input message="tns:getResourceInput"/>
      <output message="tns:getResourceOutput"/>
    </operation>
    <operation name="uploadDocument">
      <input message="tns:uploadDocInput"/>
      <output message="tns:uploadDocOutput"/>
    </operation>
  </portType>

  <binding name="SoapBinding" type="tns:NewFeaturesPortType">
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="processMatrix">
      <soap:operation soapAction="processMatrix"/>
      <input><soap:body use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></input>
      <output><soap:body use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></output>
    </operation>
    <operation name="getUser">
      <soap:operation soapAction="getUser"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="getResource">
      <soap:operation soapAction="getResource"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="uploadDocument">
      <soap:operation soapAction="uploadDocument"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <binding name="HttpBinding" type="tns:NewFeaturesPortType">
    <http:binding verb="GET"/>
    <operation name="getUser">
      <http:operation location="/users/(userId)/actions/(action)"/>
      <input><http:urlReplacement/></input>
      <output><mime:content type="text/plain"/></output>
    </operation>
    <operation name="getResource">
      <http:operation location="/api/(category)/resources/(id)/format/(format)"/>
      <input><http:urlReplacement/></input>
      <output><mime:content type="application/json"/></output>
    </operation>
  </binding>

  <service name="NewFeaturesService">
    <port name="SoapPort" binding="tns:SoapBinding">
      <soap:address location="http://localhost:8080/soap"/>
    </port>
    <port name="HttpPort" binding="tns:HttpBinding">
      <http:address location="http://localhost:8080/api"/>
    </port>
  </service>
</definitions>';
    }

    constructor() : QUnit::Test("SoapFeaturesTest", "1.0") {
        # ============================================================
        # MULTI-DIMENSIONAL ARRAY TESTS
        # ============================================================
        addTestCase("MultiDim: 2D array type parsing", \testMultiDim2DParsing());
        addTestCase("MultiDim: 3D array type parsing", \testMultiDim3DParsing());
        addTestCase("MultiDim: nested bracket notation parsing", \testMultiDimNestedBracketParsing());
        addTestCase("MultiDim: 2D array serialization", \testMultiDim2DSerialization());
        addTestCase("MultiDim: 2D array deserialization", \testMultiDim2DDeserialization());
        addTestCase("MultiDim: 2D array round-trip", \testMultiDim2DRoundTrip());
        addTestCase("MultiDim: empty 2D array", \testMultiDimEmpty2DArray());
        addTestCase("MultiDim: single row 2D array", \testMultiDimSingleRow());
        addTestCase("MultiDim: single column 2D array", \testMultiDimSingleColumn());
        addTestCase("MultiDim: large 2D array", \testMultiDimLarge2DArray());
        addTestCase("MultiDim: string matrix", \testMultiDimStringMatrix());
        addTestCase("MultiDim: arrayType attribute format", \testMultiDimArrayTypeAttribute());

        # ============================================================
        # URL REPLACEMENT TESTS
        # ============================================================
        addTestCase("URLReplacement: basic path deserialization", \testUrlReplacementBasicDeser());
        addTestCase("URLReplacement: basic path serialization", \testUrlReplacementBasicSer());
        addTestCase("URLReplacement: three-part path deserialization", \testUrlReplacementThreePart());
        addTestCase("URLReplacement: URL-encoded values", \testUrlReplacementEncodedValues());
        addTestCase("URLReplacement: special characters", \testUrlReplacementSpecialChars());
        addTestCase("URLReplacement: unicode in path", \testUrlReplacementUnicode());
        addTestCase("URLReplacement: empty value handling", \testUrlReplacementEmptyValue());
        addTestCase("URLReplacement: round-trip with encoding", \testUrlReplacementRoundTrip());
        addTestCase("URLReplacement: negative - malformed path", \testUrlReplacementNegativeMalformed());

        # ============================================================
        # HTTP BINDING FAULT CODE TESTS
        # ============================================================
        addTestCase("FaultCodes: SOAP 1.2 Sender fault (400)", \testFaultCodesSoap12Sender());
        addTestCase("FaultCodes: SOAP 1.2 Receiver fault (500)", \testFaultCodesSoap12Receiver());
        addTestCase("FaultCodes: SOAP 1.2 VersionMismatch fault (500)", \testFaultCodesSoap12VersionMismatch());
        addTestCase("FaultCodes: SOAP 1.2 MustUnderstand fault (500)", \testFaultCodesSoap12MustUnderstand());
        addTestCase("FaultCodes: SOAP 1.1 Client fault (500)", \testFaultCodesSoap11Client());
        addTestCase("FaultCodes: SOAP 1.1 Server fault (500)", \testFaultCodesSoap11Server());
        addTestCase("FaultCodes: fault body structure SOAP 1.2", \testFaultCodesBodyStructure12());
        addTestCase("FaultCodes: fault body structure SOAP 1.1", \testFaultCodesBodyStructure11());
        addTestCase("FaultCodes: content-type headers", \testFaultCodesContentType());

        # ============================================================
        # MULTIREF PROCESSING TESTS
        # ============================================================
        addTestCase("Multiref: root attribute extraction", \testMultirefRootAttribute());
        addTestCase("Multiref: xsi:type attribute preservation", \testMultirefXsiType());
        addTestCase("Multiref: multiple elements with ids", \testMultirefMultipleElements());
        addTestCase("Multiref: href reference resolution", \testMultirefHrefResolution());
        addTestCase("Multiref: nested references", \testMultirefNestedReferences());
        addTestCase("Multiref: negative - invalid href", \testMultirefNegativeInvalidHref());

        # ============================================================
        # MULTIPART/RELATED BINDING TESTS
        # ============================================================
        addTestCase("Multipart: BindingMessageDescription fields", \testMultipartBindingFields());
        addTestCase("Multipart: MultiPartRelatedMessage creation", \testMultipartMessageCreation());
        addTestCase("Multipart: add parts to message", \testMultipartAddParts());
        addTestCase("Multipart: serialize multipart message", \testMultipartSerialization());
        addTestCase("Multipart: content-type with boundary", \testMultipartContentType());
        addTestCase("Multipart: binary attachment handling", \testMultipartBinaryAttachment());

        # ============================================================
        # FORM URL ENCODING TESTS (charset > 127)
        # ============================================================
        addTestCase("FormEncoding: non-ASCII characters", \testFormEncodingNonAscii());
        addTestCase("FormEncoding: unicode characters", \testFormEncodingUnicode());
        addTestCase("FormEncoding: mixed ASCII and unicode", \testFormEncodingMixed());
        addTestCase("FormEncoding: round-trip", \testFormEncodingRoundTrip());

        # ============================================================
        # NEGATIVE TESTS - MULTI-DIMENSIONAL ARRAYS
        # ============================================================
        addTestCase("MultiDim Negative: null data handling", \testMultiDimNegativeNullData());
        addTestCase("MultiDim Negative: flat list to 2D array", \testMultiDimNegativeFlatList());

        # ============================================================
        # NEGATIVE TESTS - MULTIPART
        # ============================================================
        addTestCase("Multipart Negative: empty message serialization", \testMultipartNegativeEmptyMessage());

        # ============================================================
        # REMOVENKEYS FALSY VALUE TESTS
        # ============================================================
        addTestCase("RemoveNSKeys: preserves falsy values", \testRemoveNSKeysFalsyValues());

        # ============================================================
        # anyAttribute SCALAR CONTENT TESTS
        # ============================================================
        addTestCase("anyAttribute: scalar serialization keeps attributes", \testAnyAttrScalarSerialization());
        addTestCase("anyAttribute: scalar serialization value types", \testAnyAttrScalarValueTypes());
        addTestCase("anyAttribute: scalar deserialization", \testAnyAttrScalarDeserialization());
        addTestCase("anyAttribute: negative - scalar without anyAttribute", \testAnyAttrNegativeStrict());

        set_return_value(main());
    }

    globalSetUp() {
        ws = new WebService(TestWsdl);
    }

    # ============================================================
    # MULTI-DIMENSIONAL ARRAY TESTS
    # ============================================================

    testMultiDim2DParsing() {
        auto matrix2D = ws.tmap.Matrix2D;
        assertTrue(exists matrix2D, "Matrix2D type exists");
        assertEq("XsdArrayType", matrix2D.className(), "Matrix2D is XsdArrayType");
        XsdArrayType arr = cast<XsdArrayType>(matrix2D);
        assertEq(2, arr.dimensions, "Matrix2D has 2 dimensions");
        assertTrue(exists arr.elementType, "Matrix2D has elementType");
    }

    testMultiDim3DParsing() {
        auto matrix3D = ws.tmap.Matrix3D;
        assertTrue(exists matrix3D, "Matrix3D type exists");
        assertEq("XsdArrayType", matrix3D.className(), "Matrix3D is XsdArrayType");
        XsdArrayType arr = cast<XsdArrayType>(matrix3D);
        assertEq(3, arr.dimensions, "Matrix3D has 3 dimensions");
    }

    testMultiDimNestedBracketParsing() {
        auto nestedArray = ws.tmap.NestedArray;
        assertTrue(exists nestedArray, "NestedArray type exists");
        assertEq("XsdArrayType", nestedArray.className(), "NestedArray is XsdArrayType");
        XsdArrayType arr = cast<XsdArrayType>(nestedArray);
        assertEq(2, arr.dimensions, "NestedArray (int[][]) has 2 dimensions");
    }

    testMultiDim2DSerialization() {
        auto matrix2D = ws.tmap.Matrix2D;
        assertEq("XsdArrayType", matrix2D.className(), "Matrix2D is XsdArrayType");
        XsdArrayType arr = cast<XsdArrayType>(matrix2D);
        list<list<int>> data = ((1, 2, 3), (4, 5, 6));
        hash<auto> serialized = arr.serializeValue(ws.nsc, data, False);

        assertTrue(exists serialized."^attributes^", "Has attributes");
        assertTrue(exists serialized."^attributes^"."soapenc:arrayType", "Has arrayType attribute");
        string arrayType = serialized."^attributes^"."soapenc:arrayType";
        assertTrue(arrayType =~ /\[,\]/, "arrayType indicates 2D: " + arrayType);
        assertTrue(exists serialized."^value^", "Has value");
        assertEq(2, serialized."^value^".size(), "Has 2 rows");
    }

    testMultiDim2DDeserialization() {
        auto matrix2D = ws.tmap.Matrix2D;
        assertEq("XsdArrayType", matrix2D.className(), "Matrix2D is XsdArrayType");
        XsdArrayType arr = cast<XsdArrayType>(matrix2D);
        # Simulate parsed XML structure for 2D array
        hash<auto> parsed = {
            "^attributes^": {"soapenc:arrayType": "xsd:int[,]"},
            "^value^": ((1, 2), (3, 4)),
        };
        auto result = arr.deserializeValue("test", ws.tmap, NOTHING, parsed);
        assertEq(2, result.size(), "Deserialized has 2 rows");
        assertEq(2, result[0].size(), "First row has 2 elements");
        assertEq(1, result[0][0], "First element is 1");
        assertEq(4, result[1][1], "Last element is 4");
    }

    testMultiDim2DRoundTrip() {
        auto matrix2D = ws.tmap.Matrix2D;
        assertEq("XsdArrayType", matrix2D.className(), "Matrix2D is XsdArrayType");
        XsdArrayType arr = cast<XsdArrayType>(matrix2D);
        list<list<int>> original = ((10, 20, 30), (40, 50, 60), (70, 80, 90));
        hash<auto> serialized = arr.serializeValue(ws.nsc, original, False);
        auto deserialized = arr.deserializeValue("test", ws.tmap, NOTHING, serialized);

        assertEq(3, deserialized.size(), "Round-trip: 3 rows");
        assertEq(3, deserialized[0].size(), "Round-trip: 3 columns");
        assertEq(10, deserialized[0][0], "Round-trip: first element");
        assertEq(50, deserialized[1][1], "Round-trip: middle element");
        assertEq(90, deserialized[2][2], "Round-trip: last element");
    }

    testMultiDimEmpty2DArray() {
        auto matrix2D = ws.tmap.Matrix2D;
        assertEq("XsdArrayType", matrix2D.className(), "Matrix2D is XsdArrayType");
        XsdArrayType arr = cast<XsdArrayType>(matrix2D);
        list<list<int>> empty = ();
        hash<auto> serialized = arr.serializeValue(ws.nsc, empty, False);
        assertTrue(exists serialized."^attributes^", "Empty array has attributes");
        # Empty array should have empty value
        assertTrue(!serialized."^value^" || serialized."^value^".size() == 0, "Empty array has no values");
    }

    testMultiDimSingleRow() {
        auto matrix2D = ws.tmap.Matrix2D;
        assertEq("XsdArrayType", matrix2D.className(), "Matrix2D is XsdArrayType");
        XsdArrayType arr = cast<XsdArrayType>(matrix2D);
        list<list<int>> singleRow = ((1, 2, 3, 4, 5),);
        hash<auto> serialized = arr.serializeValue(ws.nsc, singleRow, False);
        auto deserialized = arr.deserializeValue("test", ws.tmap, NOTHING, serialized);
        assertEq(1, deserialized.size(), "Single row: 1 row");
        assertEq(5, deserialized[0].size(), "Single row: 5 columns");
    }

    testMultiDimSingleColumn() {
        auto matrix2D = ws.tmap.Matrix2D;
        assertEq("XsdArrayType", matrix2D.className(), "Matrix2D is XsdArrayType");
        XsdArrayType arr = cast<XsdArrayType>(matrix2D);
        list<list<int>> singleCol = ((1,), (2,), (3,));
        hash<auto> serialized = arr.serializeValue(ws.nsc, singleCol, False);
        auto deserialized = arr.deserializeValue("test", ws.tmap, NOTHING, serialized);
        assertEq(3, deserialized.size(), "Single column: 3 rows");
        assertEq(1, deserialized[0].size(), "Single column: 1 column");
    }

    testMultiDimLarge2DArray() {
        auto matrix2D = ws.tmap.Matrix2D;
        assertEq("XsdArrayType", matrix2D.className(), "Matrix2D is XsdArrayType");
        XsdArrayType arr = cast<XsdArrayType>(matrix2D);
        # Create 10x10 matrix
        list<list<int>> large = ();
        for (int i = 0; i < 10; i++) {
            list<int> row = ();
            for (int j = 0; j < 10; j++) {
                row += i * 10 + j;
            }
            large += (row,);
        }
        hash<auto> serialized = arr.serializeValue(ws.nsc, large, False);
        auto deserialized = arr.deserializeValue("test", ws.tmap, NOTHING, serialized);
        assertEq(10, deserialized.size(), "Large array: 10 rows");
        assertEq(10, deserialized[0].size(), "Large array: 10 columns");
        assertEq(0, deserialized[0][0], "Large array: first element");
        assertEq(99, deserialized[9][9], "Large array: last element");
    }

    testMultiDimStringMatrix() {
        auto stringMatrix = ws.tmap.StringMatrix;
        assertEq("XsdArrayType", stringMatrix.className(), "StringMatrix is XsdArrayType");
        XsdArrayType arr = cast<XsdArrayType>(stringMatrix);
        assertEq(2, arr.dimensions, "StringMatrix has 2 dimensions");
        list<list<string>> data = (("a", "b"), ("c", "d"));
        hash<auto> serialized = arr.serializeValue(ws.nsc, data, False);
        auto deserialized = arr.deserializeValue("test", ws.tmap, NOTHING, serialized);
        assertEq("a", deserialized[0][0], "String matrix: first element");
        assertEq("d", deserialized[1][1], "String matrix: last element");
    }

    testMultiDimArrayTypeAttribute() {
        auto matrix2D = ws.tmap.Matrix2D;
        auto matrix3D = ws.tmap.Matrix3D;
        assertEq("XsdArrayType", matrix2D.className(), "Matrix2D is XsdArrayType");
        assertEq("XsdArrayType", matrix3D.className(), "Matrix3D is XsdArrayType");

        XsdArrayType arr2D = cast<XsdArrayType>(matrix2D);
        XsdArrayType arr3D = cast<XsdArrayType>(matrix3D);

        hash<auto> ser2D = arr2D.serializeValue(ws.nsc, ((1,),), False);
        hash<auto> ser3D = arr3D.serializeValue(ws.nsc, ((("a",),),), False);

        string at2D = ser2D."^attributes^"."soapenc:arrayType";
        string at3D = ser3D."^attributes^"."soapenc:arrayType";

        # 2D should have [,] (one comma)
        assertTrue(at2D =~ /\[,\]$/, "2D arrayType ends with [,]: " + at2D);
        # 3D should have [,,] (two commas)
        assertTrue(at3D =~ /\[,,\]$/, "3D arrayType ends with [,,]: " + at3D);
    }

    # ============================================================
    # URL REPLACEMENT TESTS
    # ============================================================

    testUrlReplacementBasicDeser() {
        WSOperation op = ws.getOperation("getUser");
        *OperationalBinding httpBinding = op.bindings.HttpBinding;
        assertTrue(exists httpBinding, "HTTP binding found");

        string path = "/users/john123/actions/view";
        hash<auto> result = op.deserializeRequestPath(path, httpBinding.name);

        assertEq("john123", result.userId, "userId extracted");
        assertEq("view", result.action, "action extracted");
    }

    testUrlReplacementBasicSer() {
        WSOperation op = ws.getOperation("getUser");
        *OperationalBinding httpBinding = op.bindings.HttpBinding;
        assertTrue(exists httpBinding, "HTTP binding found");

        hash<auto> data = {"userId": "user456", "action": "edit"};
        hash<auto> result = op.serializeRequest(data, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, httpBinding.name);

        assertTrue(result.path =~ /user456/, "path contains userId");
        assertTrue(result.path =~ /edit/, "path contains action");
        assertTrue(result.path =~ /\/users\/user456\/actions\/edit/, "path has correct format");
    }

    testUrlReplacementThreePart() {
        WSOperation op = ws.getOperation("getResource");
        *OperationalBinding httpBinding = op.bindings.HttpBinding;
        assertTrue(exists httpBinding, "HTTP binding found");

        string path = "/api/documents/resources/12345/format/json";
        hash<auto> result = op.deserializeRequestPath(path, httpBinding.name);

        assertEq("documents", result.category, "category extracted");
        assertEq("12345", result.id, "id extracted");
        assertEq("json", result.format, "format extracted");
    }

    testUrlReplacementEncodedValues() {
        WSOperation op = ws.getOperation("getUser");
        *OperationalBinding httpBinding = op.bindings.HttpBinding;

        # Test URL-encoded value in path
        string path = "/users/john%20doe/actions/view%2Fedit";
        hash<auto> result = op.deserializeRequestPath(path, httpBinding.name);

        assertEq("john doe", result.userId, "URL-decoded userId with space");
        assertEq("view/edit", result.action, "URL-decoded action with slash");
    }

    testUrlReplacementSpecialChars() {
        WSOperation op = ws.getOperation("getUser");
        *OperationalBinding httpBinding = op.bindings.HttpBinding;

        # Serialize with special characters
        hash<auto> data = {"userId": "user@example.com", "action": "send+receive"};
        hash<auto> result = op.serializeRequest(data, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, httpBinding.name);

        assertTrue(result.path =~ /%40/, "@ is URL-encoded");
        assertTrue(result.path =~ /%2B/, "+ is URL-encoded");
    }

    testUrlReplacementUnicode() {
        WSOperation op = ws.getOperation("getUser");
        *OperationalBinding httpBinding = op.bindings.HttpBinding;

        # Test with unicode characters
        hash<auto> data = {"userId": "用户", "action": "查看"};
        hash<auto> ser = op.serializeRequest(data, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, httpBinding.name);

        # Should be URL-encoded
        assertTrue(ser.path =~ /%/, "Unicode is URL-encoded");

        # Round-trip should work
        hash<auto> deser = op.deserializeRequestPath(ser.path, httpBinding.name);
        assertEq("用户", deser.userId, "Unicode userId round-trip");
        assertEq("查看", deser.action, "Unicode action round-trip");
    }

    testUrlReplacementEmptyValue() {
        WSOperation op = ws.getOperation("getUser");
        *OperationalBinding httpBinding = op.bindings.HttpBinding;

        # Test with empty action value
        string path = "/users/john/actions/";
        hash<auto> result = op.deserializeRequestPath(path, httpBinding.name);

        assertEq("john", result.userId, "userId extracted with empty action");
        assertEq("", result.action, "Empty action extracted");
    }

    testUrlReplacementRoundTrip() {
        WSOperation op = ws.getOperation("getResource");
        *OperationalBinding httpBinding = op.bindings.HttpBinding;

        hash<auto> original = {"category": "images", "id": "img-2024-001", "format": "png"};
        hash<auto> ser = op.serializeRequest(original, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, httpBinding.name);
        hash<auto> deser = op.deserializeRequestPath(ser.path, httpBinding.name);

        assertEq(original.category, deser.category, "Round-trip category");
        assertEq(original.id, deser.id, "Round-trip id");
        assertEq(original.format, deser.format, "Round-trip format");
    }

    testUrlReplacementNegativeMalformed() {
        WSOperation op = ws.getOperation("getUser");
        *OperationalBinding httpBinding = op.bindings.HttpBinding;

        # Test with malformed path (missing segment)
        bool caught = False;
        try {
            string path = "/users/john";  # Missing /actions/xxx
            op.deserializeRequestPath(path, httpBinding.name);
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertTrue(ex.err =~ /SOAP|URL|replacement/i, "Error mentions URL or replacement");
        }
        assertTrue(caught, "Malformed path throws exception");
    }

    # ============================================================
    # HTTP BINDING FAULT CODE TESTS
    # ============================================================

    testFaultCodesSoap12Sender() {
        hash<auto> response = makeFaultResponse(True, SoapHandler::SoapFaultSender);
        assertEq(400, response.code, "SOAP 1.2 Sender fault = HTTP 400");
    }

    testFaultCodesSoap12Receiver() {
        hash<auto> response = makeFaultResponse(True, SoapHandler::SoapFaultReceiver);
        assertEq(500, response.code, "SOAP 1.2 Receiver fault = HTTP 500");
    }

    testFaultCodesSoap12VersionMismatch() {
        hash<auto> response = makeFaultResponse(True, SoapHandler::SoapFaultVersionMismatch);
        assertEq(500, response.code, "SOAP 1.2 VersionMismatch fault = HTTP 500");
    }

    testFaultCodesSoap12MustUnderstand() {
        hash<auto> response = makeFaultResponse(True, SoapHandler::SoapFaultMustUnderstand);
        assertEq(500, response.code, "SOAP 1.2 MustUnderstand fault = HTTP 500");
    }

    testFaultCodesSoap11Client() {
        hash<auto> response = makeFaultResponse(False, SoapHandler::SoapFaultSender);
        assertEq(500, response.code, "SOAP 1.1 Client fault = HTTP 500");
        assertTrue(response.body =~ /soapenv:Client/, "SOAP 1.1 uses Client code");
    }

    testFaultCodesSoap11Server() {
        hash<auto> response = makeFaultResponse(False, SoapHandler::SoapFaultReceiver);
        assertEq(500, response.code, "SOAP 1.1 Server fault = HTTP 500");
        assertTrue(response.body =~ /soapenv:Server/, "SOAP 1.1 uses Server code");
    }

    testFaultCodesBodyStructure12() {
        hash<auto> response = makeFaultResponse(True, SoapHandler::SoapFaultSender);

        assertTrue(response.body =~ /soapenv:Envelope/, "Has SOAP envelope");
        assertTrue(response.body =~ /soapenv:Body/, "Has SOAP body");
        assertTrue(response.body =~ /soapenv:Fault/, "Has SOAP fault");
        assertTrue(response.body =~ /soapenv:Code/, "SOAP 1.2 has Code element");
        assertTrue(response.body =~ /soapenv:Value/, "SOAP 1.2 has Value element");
        assertTrue(response.body =~ /soapenv:Reason/, "SOAP 1.2 has Reason element");
        assertTrue(response.body =~ /soapenv:Sender/, "SOAP 1.2 Sender value");
    }

    testFaultCodesBodyStructure11() {
        hash<auto> response = makeFaultResponse(False, SoapHandler::SoapFaultSender);

        assertTrue(response.body =~ /soapenv:Envelope/, "Has SOAP envelope");
        assertTrue(response.body =~ /soapenv:Body/, "Has SOAP body");
        assertTrue(response.body =~ /soapenv:Fault/, "Has SOAP fault");
        assertTrue(response.body =~ /faultcode/, "SOAP 1.1 has faultcode element");
        assertTrue(response.body =~ /faultstring/, "SOAP 1.1 has faultstring element");
    }

    testFaultCodesContentType() {
        hash<auto> response12 = makeFaultResponse(True, SoapHandler::SoapFaultSender);
        hash<auto> response11 = makeFaultResponse(False, SoapHandler::SoapFaultSender);

        assertEq("application/soap+xml", response12.hdr."Content-Type", "SOAP 1.2 content-type");
        assertEq("text/xml", response11.hdr."Content-Type", "SOAP 1.1 content-type");
    }

    # ============================================================
    # MULTIREF PROCESSING TESTS
    # ============================================================

    testMultirefRootAttribute() {
        string soapMsg = '<?xml version="1.0"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <response>
      <item id="id1" root="1"><name>Root</name></item>
      <item id="id2" root="0"><name>Referenced</name></item>
    </response>
  </soap:Body>
</soap:Envelope>';

        hash<auto> parsed = parse_xml(soapMsg);
        assertTrue(exists parsed, "SOAP message parsed");

        auto body = parsed."soap:Envelope"."soap:Body".response;
        assertTrue(exists body, "Response body exists");

        # Verify root attributes are present
        assertTrue(exists body.item[0]."^attributes^".root, "First item has root attribute");
        assertEq("1", body.item[0]."^attributes^".root, "First item root=1");
        assertEq("0", body.item[1]."^attributes^".root, "Second item root=0");
    }

    testMultirefXsiType() {
        string soapMsg = '<?xml version="1.0"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xmlns:tns="http://test.example.com/">
  <soap:Body>
    <response>
      <item id="id1" xsi:type="tns:Matrix2D"><value>1</value></item>
    </response>
  </soap:Body>
</soap:Envelope>';

        hash<auto> parsed = parse_xml(soapMsg);
        auto item = parsed."soap:Envelope"."soap:Body".response.item;

        assertTrue(exists item."^attributes^"."xsi:type", "xsi:type attribute exists");
        assertEq("tns:Matrix2D", item."^attributes^"."xsi:type", "xsi:type value preserved");
    }

    testMultirefMultipleElements() {
        string soapMsg = '<?xml version="1.0"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <response>
      <person id="p1"><name>Alice</name></person>
      <person id="p2"><name>Bob</name></person>
      <person id="p3"><name>Charlie</name></person>
    </response>
  </soap:Body>
</soap:Envelope>';

        hash<auto> parsed = parse_xml(soapMsg);
        auto body = parsed."soap:Envelope"."soap:Body".response;

        assertEq(3, body.person.size(), "All 3 person elements parsed");
        assertEq("p1", body.person[0]."^attributes^".id, "First person id");
        assertEq("p2", body.person[1]."^attributes^".id, "Second person id");
        assertEq("p3", body.person[2]."^attributes^".id, "Third person id");
    }

    testMultirefHrefResolution() {
        string soapMsg = '<?xml version="1.0"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <getPersonResponse>
      <result href="#person1"/>
    </getPersonResponse>
    <multiRef id="person1"><name>John</name><age>30</age></multiRef>
  </soap:Body>
</soap:Envelope>';

        hash<auto> parsed = parse_xml(soapMsg);
        assertTrue(exists parsed, "SOAP message with href parsed");

        auto response = parsed."soap:Envelope"."soap:Body".getPersonResponse;
        assertTrue(exists response.result."^attributes^".href, "href attribute exists");
        assertEq("#person1", response.result."^attributes^".href, "href value correct");

        auto multiRef = parsed."soap:Envelope"."soap:Body".multiRef;
        assertTrue(exists multiRef, "multiRef element exists");
        assertEq("person1", multiRef."^attributes^".id, "multiRef id correct");
    }

    testMultirefNestedReferences() {
        string soapMsg = '<?xml version="1.0"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <response>
      <order id="o1">
        <customer href="#c1"/>
        <items><item href="#i1"/><item href="#i2"/></items>
      </order>
    </response>
    <multiRef id="c1"><name>Customer</name></multiRef>
    <multiRef id="i1"><product>Widget</product></multiRef>
    <multiRef id="i2"><product>Gadget</product></multiRef>
  </soap:Body>
</soap:Envelope>';

        hash<auto> parsed = parse_xml(soapMsg);
        assertTrue(exists parsed, "SOAP message with nested refs parsed");

        auto order = parsed."soap:Envelope"."soap:Body".response.order;
        assertTrue(exists order.customer."^attributes^".href, "customer href exists");
        assertTrue(exists order.items.item, "items exist");
        assertEq(2, order.items.item.size(), "2 item references");
    }

    testMultirefNegativeInvalidHref() {
        # This tests the XML parsing, not the WSDL resolution
        # Invalid href should still parse, but may cause errors during deserialization
        string soapMsg = '<?xml version="1.0"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <response>
      <result href="#nonexistent"/>
    </response>
  </soap:Body>
</soap:Envelope>';

        hash<auto> parsed = parse_xml(soapMsg);
        assertTrue(exists parsed, "SOAP message with invalid href still parses");
        assertEq("#nonexistent", parsed."soap:Envelope"."soap:Body".response.result."^attributes^".href,
            "Invalid href value preserved");
    }

    # ============================================================
    # MULTIPART/RELATED BINDING TESTS
    # ============================================================

    testMultipartBindingFields() {
        BindingMessageDescription bmd();

        # Verify multipart field exists and can be set
        assertEq(NOTHING, bmd.multipart, "multipart initially null");
        bmd.multipart = Mime::MPT_RELATED;
        assertEq(Mime::MPT_RELATED, bmd.multipart, "multipart set to related");

        # Verify parts field exists and can be set
        assertEq(NOTHING, bmd.parts, "parts initially null");
        bmd.parts = {"attachment1": "image/png", "attachment2": "application/pdf"};
        assertEq(2, bmd.parts.size(), "parts has 2 entries");
        assertEq("image/png", bmd.parts.attachment1, "attachment1 content type");
    }

    testMultipartMessageCreation() {
        MultiPartRelatedMessage mpm();
        assertEq(0, mpm.size(), "New multipart message has 0 parts");
        assertEq("MultiPartRelatedMessage", mpm.className(), "Correct class name");
    }

    testMultipartAddParts() {
        MultiPartRelatedMessage mpm();

        # Add SOAP body as first part
        string soapBody = '<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"><soap:Body/></soap:Envelope>';
        mpm.splicePart(soapBody, "<main>", "application/soap+xml");
        assertEq(1, mpm.size(), "1 part after splice");

        # Add attachment
        binary attachment = <deadbeef>;
        mpm.addPart(attachment, "<attachment1>", "application/octet-stream");
        assertEq(2, mpm.size(), "2 parts after add");
    }

    testMultipartSerialization() {
        MultiPartRelatedMessage mpm();

        string soapBody = '<?xml version="1.0"?><test>data</test>';
        mpm.splicePart(soapBody, "<soap-body>", "text/xml");

        binary data = <cafebabe>;
        mpm.addPart(data, "<binary-data>", "application/octet-stream");

        hash<Mime::MessageInfo> result = mpm.getMsgAndHeaders();

        assertTrue(exists result.body, "Serialized message has body");
        assertTrue(exists result.hdr, "Serialized message has headers");
        assertTrue(result.hdr."Content-Type" =~ /multipart\/related/, "Content-Type is multipart/related");
        assertTrue(result.hdr."Content-Type" =~ /boundary=/, "Content-Type has boundary");
    }

    testMultipartContentType() {
        MultiPartRelatedMessage mpm();
        mpm.splicePart("test", "<main>", "text/plain");

        hash<Mime::MessageInfo> result = mpm.getMsgAndHeaders();
        string ct = result.hdr."Content-Type";

        assertTrue(ct =~ /multipart\/related/, "Is multipart/related");
        assertTrue(ct =~ /start=/, "Has start parameter");
        assertTrue(ct =~ /<main>/, "Start references main part");
    }

    testMultipartBinaryAttachment() {
        MultiPartRelatedMessage mpm();

        # Create large binary data
        binary largeData = binary();
        for (int i = 0; i < 1000; i++) {
            largeData += <00112233445566778899aabbccddeeff>;
        }

        mpm.splicePart("<root/>", "<xml>", "text/xml");
        mpm.addPart(largeData, "<binary>", "application/octet-stream");

        hash<Mime::MessageInfo> result = mpm.getMsgAndHeaders();
        assertTrue(result.body.size() > largeData.size(), "Serialized includes all data");
    }

    # ============================================================
    # FORM URL ENCODING TESTS (charset > 127)
    # ============================================================

    testFormEncodingNonAscii() {
        hash<auto> h = {"name": "José", "city": "München"};
        string encoded = mime_get_form_urlencoded_string(h);

        assertTrue(encoded =~ /%C3%A9/, "é is UTF-8 encoded: " + encoded);
        assertTrue(encoded =~ /%C3%BC/, "ü is UTF-8 encoded: " + encoded);
    }

    testFormEncodingUnicode() {
        hash<auto> h = {"greeting": "你好", "emoji": "🎉"};
        string encoded = mime_get_form_urlencoded_string(h);

        assertTrue(encoded =~ /%/, "Unicode is percent-encoded");
        # 你 is E4 BD A0 in UTF-8
        assertTrue(encoded =~ /%E4%BD%A0/, "Chinese character encoded: " + encoded);
    }

    testFormEncodingMixed() {
        hash<auto> h = {"ascii": "hello", "latin": "café", "unicode": "日本"};
        string encoded = mime_get_form_urlencoded_string(h);

        assertTrue(encoded =~ /ascii=hello/, "ASCII preserved");
        assertTrue(encoded =~ /latin=caf%C3%A9/, "Latin extended encoded");
        assertTrue(encoded =~ /%E6%97%A5%E6%9C%AC/, "Japanese encoded");
    }

    testFormEncodingRoundTrip() {
        hash<auto> original = {
            "name": "Ñoño",
            "address": "123 日本語 Street",
            "notes": "Special: äöü ß €"
        };

        string encoded = mime_get_form_urlencoded_string(original);
        hash<auto> decoded = mime_parse_form_urlencoded_string(encoded);

        assertEq(original.name, decoded.name, "Round-trip: name");
        assertEq(original.address, decoded.address, "Round-trip: address");
        assertEq(original.notes, decoded.notes, "Round-trip: notes");
    }

    # ============================================================
    # NEGATIVE TESTS - MULTI-DIMENSIONAL ARRAYS
    # ============================================================

    testMultiDimNegativeNullData() {
        auto matrix2D = ws.tmap.Matrix2D;
        assertEq("XsdArrayType", matrix2D.className(), "Matrix2D is XsdArrayType");
        XsdArrayType arr = cast<XsdArrayType>(matrix2D);

        # Test serialization with NOTHING
        hash<auto> serialized = arr.serializeValue(ws.nsc, NOTHING, False);
        assertTrue(exists serialized."^attributes^", "NOTHING serialization has attributes");
    }

    testMultiDimNegativeFlatList() {
        auto matrix2D = ws.tmap.Matrix2D;
        assertEq("XsdArrayType", matrix2D.className(), "Matrix2D is XsdArrayType");
        XsdArrayType arr = cast<XsdArrayType>(matrix2D);

        # A flat list passed to a 2D array - should handle gracefully
        list<int> flatList = (1, 2, 3, 4, 5);
        hash<auto> serialized = arr.serializeValue(ws.nsc, flatList, False);

        # Should still produce valid output (each element as a "row")
        assertTrue(exists serialized."^attributes^", "Flat list serialization has attributes");
    }

    # ============================================================
    # NEGATIVE TESTS - MULTIPART
    # ============================================================

    testMultipartNegativeEmptyMessage() {
        MultiPartRelatedMessage mpm();

        # Empty message should not crash on creation
        assertEq(0, mpm.size(), "Empty message has 0 parts");

        # Getting headers from empty message should throw an exception
        bool caught = False;
        try {
            mpm.getMsgAndHeaders();
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("HTTP-MULTIPART-ERROR", ex.err, "Empty message throws HTTP-MULTIPART-ERROR");
            assertTrue(ex.desc =~ /no parts/i, "Error mentions no parts");
        }
        assertTrue(caught, "Empty message getMsgAndHeaders() throws exception");
    }

    # ============================================================
    # REMOVENKEYS FALSY VALUE TESTS
    # ============================================================

    testRemoveNSKeysFalsyValues() {
        # Test that removeNSKeys preserves falsy values (0, "", False)
        *hash<auto> h = {
            "ns:zero": 0,
            "ns:empty": "",
            "ns:false": False,
            "ns:normal": "value",
        };

        WSDL::XsdBase::removeNSKeys(\h);

        # All values should be preserved
        assertTrue(exists h.zero, "zero key exists after removeNSKeys");
        assertEq(0, h.zero, "zero value preserved");

        assertTrue(exists h.empty, "empty key exists after removeNSKeys");
        assertEq("", h.empty, "empty string value preserved");

        assertTrue(exists h."false", "false key exists after removeNSKeys");
        assertEq(False, h."false", "False value preserved");

        assertTrue(exists h.normal, "normal key exists after removeNSKeys");
        assertEq("value", h.normal, "normal value preserved");

        # Original namespaced keys should be gone
        assertFalse(exists h."ns:zero", "ns:zero removed");
        assertFalse(exists h."ns:empty", "ns:empty removed");
        assertFalse(exists h."ns:false", "ns:false removed");
        assertFalse(exists h."ns:normal", "ns:normal removed");
    }

    # ============================================================
    # anyAttribute SCALAR CONTENT TESTS
    # ============================================================

    #! Returns the named complexType from the test WSDL
    private XsdComplexType getComplexType(string name) {
        *XsdAbstractType t = ws.tmap{name};
        assertTrue(exists t, sprintf("type %y exists in the WebService type map", name));
        assertTrue(t instanceof XsdComplexType, sprintf("type %y is a complexType", name));
        return cast<XsdComplexType>(t);
    }

    #! A complexType with anyAttribute accepts a scalar, wrapped as "^value^"
    /** The resulting hash must keep an "auto" value type: the "^attributes^" key added afterwards
        holds a hash, so a hash narrowed to "hash<string, string>" by the scalar would silently fold
        the attributes to an empty string and drop "xsi:type" from the serialized message.
    */
    testAnyAttrScalarSerialization() {
        XsdComplexType ct = getComplexType("AnyAttrSeqType");

        auto rv = ct.serializeValue(ct.nsc, "scalar-text", False);
        assertEq(NT_HASH, rv.typeCode(), "serializing a scalar for an anyAttribute type gives a hash");
        assertEq("scalar-text", rv."^value^", "the scalar is wrapped as the \"^value^\" key");

        # this is the assertion that fails if the hash narrows to hash<string, string>
        assertEq(NT_HASH, rv."^attributes^".typeCode(), "\"^attributes^\" is a hash, not a folded string");
        assertEq("AnyAttrSeqType", (rv."^attributes^"."xsi:type" =~ x/:(.*)/)[0],
            "the \"xsi:type\" attribute names the complexType");
    }

    #! Non-string scalars narrow to their own types, so cover them too
    testAnyAttrScalarValueTypes() {
        XsdComplexType ct = getComplexType("AnyAttrSeqType");

        # a hash narrowed by an int/date/bool value throws rather than folding silently
        hash<auto> values = {
            "int": 42,
            "date": 2026-01-15T10:30:00Z,
            "bool": True,
            "float": 3.14,
        };
        foreach hash<auto> i in (values.pairIterator()) {
            auto rv = ct.serializeValue(ct.nsc, i.value, False);
            assertEq(i.value, rv."^value^", sprintf("%s scalar wrapped as \"^value^\"", i.key));
            assertEq(NT_HASH, rv."^attributes^".typeCode(),
                sprintf("\"^attributes^\" is a hash for a %s scalar", i.key));
        }
    }

    #! Deserializing a scalar through the anyAttribute branch round-trips the value
    testAnyAttrScalarDeserialization() {
        XsdComplexType ct = getComplexType("AnyAttrSeqType");
        hash<string, XsdAbstractType> tmap = ws.tmap;

        # a bare scalar collapses back to the scalar, since "^value^" is the only key
        assertEq("scalar-text", ct.deserializeValue("body", tmap, NOTHING, "scalar-text"),
            "a scalar deserializes back to the scalar");

        # with attributes present the attribute hash must survive alongside the value
        auto rv = ct.deserializeValue("body", tmap, NOTHING,
            {"^attributes^": {"lang": "en"}, "^value^": "scalar-text"});
        assertEq("scalar-text", rv."^value^", "the value survives deserialization with attributes");
        assertEq({"lang": "en"}, rv."^attributes^", "declared attributes survive deserialization");

        # structured content still deserializes normally
        auto sv = ct.deserializeValue("body", tmap, NOTHING,
            {"^attributes^": {"lang": "en"}, "part": "p"});
        assertEq("p", sv.part, "structured content deserializes normally");
        assertEq({"lang": "en"}, sv."^attributes^", "attributes survive with structured content");
    }

    #! Without anyAttribute, a scalar for a structured complexType must be rejected
    testAnyAttrNegativeStrict() {
        XsdComplexType strict = getComplexType("StrictSeqType");

        assertThrows("SOAP-SERIALIZATION-ERROR", \strict.serializeValue(),
            (strict.nsc, "scalar-text", False),
            "serializing a scalar without anyAttribute throws");
        assertThrows("SOAP-DESERIALIZATION-ERROR", \strict.deserializeValue(),
            ("body", ws.tmap, NOTHING, "scalar-text"),
            "deserializing a scalar without anyAttribute throws");
    }

    # ============================================================
    # HELPER METHODS
    # ============================================================

    private hash<auto> makeFaultResponse(bool soap12, string faultCode) {
        hash o;

        int httpCode;
        if (soap12) {
            httpCode = (faultCode == SoapHandler::SoapFaultSender) ? 400 : 500;
        } else {
            httpCode = 500;
        }

        if (soap12) {
            o = WSDL::ENVELOPE_12_NS;
            o."soapenv:Envelope"."soapenv:Body" = {
                "soapenv:Fault": {
                    "soapenv:Code": {
                        "soapenv:Value": "soapenv:" + faultCode,
                    },
                    "soapenv:Reason": {
                        "soapenv:Text": "TEST-ERROR: Test description",
                    },
                },
            };
        } else {
            string soap11Code = (faultCode == SoapHandler::SoapFaultSender) ? "Client" : "Server";
            o = WSDL::ENVELOPE_11_NS;
            o."soapenv:Envelope"."soapenv:Body" = {
                "soapenv:Fault": {
                    "faultcode": "soapenv:" + soap11Code,
                    "faultstring": "TEST-ERROR: Test description",
                },
            };
        }

        return {
            "code": httpCode,
            "body": make_xml(o),
            "hdr": {
                "Content-Type": soap12 ? "application/soap+xml" : "text/xml",
            },
        };
    }
}

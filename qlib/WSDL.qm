# make sure we have the required qore version
%requires qore >= 2.0

# requires XML functionality
%requires xml

# need mime definitions
%requires Mime >= 1.4.2

%requires(reexport) DataProvider
%requires FileLocationHandler

%modern

# allow the use of the := weak reference assignment operator
%allow-weak-references

%disable-warning unreferenced-variable

module WSDL {
    version = "0.5.8";
    desc = "WSDL module providing functionality for SOAP";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/*
    WSDL classes
    provides some minimal WSDL and XSD support for SOAP messaging used by the SoapClient class and the SoapHandler

    not complete, needs namespace verification, improved XSD support, element groups, etc
*/

/** @mainpage WSDL Module

    @tableofcontents

    @section wsdlintro Introduction to the WSDL Module

    The %WSDL module provides functionality for <a href="http://en.wikipedia.org/wiki/SOAP">SOAP</a> 1.1 and 1.2.

    The main purpose of this module is to provide the infrastructure for developing SOAP client and server services.

    The main components of this module are as follows:
    - @ref WSDL::WebService "WebService": represents a WSDL file; an easy way to get an object of this type from a URL
      is by calling WSDL::WSDLLib::getWSDL()
    - @ref WSDL::WSDLLib "WSDLLib": a class of static functions providing helper functions for the module
    - @ref WSDL::WSOperation "WSOperation": a class representing a single operation from a SOAP web service
    - @ref WSDL::WSMessageHelper "WSMessageHelper": a class to create sample messages used by SOAP operations

    See the following for modules using the %WSDL module:
    - <a href="../../SoapClient/html/index.html">SoapClient user module</a>
    - <a href="../../SoapHandler/html/index.html">SoapHandler user module</a>

    @section wsdlrelnotes WSDL Module Release Notes

    @subsection wsdl_0_5_8 WSDL v0.5.8
    - added support for the XSD \c include statement
    - fixed resolving relative \c schemaLocation values; they are now resolved against the location of the document
      containing the reference and not against the location of the top-level WSDL
    - fixed handling element \c ref attributes with no namespace prefix
    - fixed handling element declarations with no type information; such elements now have type \c xs:anyType
    - fixed handling \c simpleType \c union definitions with more than one anonymous member type definition
    - fixed resolving \c simpleType \c restriction base types declared after the restricting type in the schema
    - fixed serializing XSD attribute values; attribute values are now serialized according to their type like
      element values, so dates, booleans, and binary values are written in their XSD representation
    - fixed serializing \c xs:boolean values given as strings; \c "false" and \c "0" are now serialized as
      \c "false" instead of \c "true"
    - fixed handling \c complexType \c choice definitions declared with \c minOccurs="0"; such choices no longer
      require a member to be present
    - fixed a runtime error serializing a \c complexType \c choice with no member supplied; a descriptive
      exception is now thrown if the choice is required
    - fixed a runtime error retrieving the data provider type for a \c complexType \c choice definition
    - fixed deserializing messages whose parts are split between the SOAP header and the SOAP body; the body parts
      are now taken from the \c parts attribute of the \c soap:body element, or, if that attribute is not present,
      from the message parts not bound to a SOAP header
    - fixed reporting enumeration values for numeric, boolean, and date types; they were always reported as strings,
      which also caused an error when retrieving the data provider type for such a type
    - data provider types for scalar XSD types are now soft types (ex: \c softint), matching the values accepted
      when serializing
    - fixed the data provider type for \c xs:boolean; string values are now parsed according to the XSD boolean
      lexical space, so that \c "false" and \c "0" are converted to @ref False "False"
    - fixed generating example messages for \c complexType \c choice definitions and \c simpleType \c union
      definitions
      (<a href="https://github.com/qoretechnologies/qore/issues/5405">issue 5405</a>)
    - added support for async schema import caching for polling operations
    - extracted the XSD schema parsing infrastructure from \c WebService into a new public
      @ref WSDL::XsdSchema class so that bare XSD documents (for example, industry message
      standards delivered as XSD packages) can be parsed and queried without a WSDL wrapper;
      \c WebService now inherits from \c XsdSchema with no API change to existing callers
    - fixed the type registry to support XSDs that reuse the same local type name across
      different target namespaces (for example, UN/CEFACT \c PictureType is defined in both
      \c UnqualifiedDataType:37 and \c ReusableAggregateBusinessInformationEntity:37). Types
      are now keyed by \c "{namespace_uri}local_name" alongside a backward-compatible local-name
      fallback entry. Type resolution prefers namespace-qualified lookup when the input
      namespace prefix is known. Single-namespace WSDLs continue to work unchanged. New helper
      @ref WSDL::make_qname() exposes the qualified-key construction.
    - fixed handling nested XSD model groups; elements declared in an \c xs:sequence, \c xs:choice, or \c xs:all
      nested in another model group were silently dropped from the type, so they could neither be serialized nor
      deserialized
    - added support for \c xs:choice alternatives declared as nested model groups; all the elements of a single
      alternative can now be serialized and deserialized together
    - fixed the data provider type for a \c complexType with a \c sequence containing a \c choice block; the
      members of the choice were not reported as fields
      (<a href="https://github.com/qoretechnologies/qore/issues/5410">issue 5410</a>)
    - fixed combining multiple \c xs:pattern facets declared in the same restriction; they were intersected, so a
      type declaring one pattern per alternative form (ex: one per IPv6 textual form) rejected every value.  XSD
      1.0 part 2 4.3.4.3 combines sibling patterns with \c "|", so a value matching any one of them is valid;
      patterns declared in different derivation steps continue to be intersected
    - fixed anchoring \c xs:pattern facets with a top-level alternation; the pattern is now wrapped in a
      non-capturing group, so that \c "a|b" is anchored as \c "^(?:a|b)$" and no longer accepts any value merely
      starting with \c "a" or ending with \c "b"
      (<a href="https://github.com/qoretechnologies/qore/issues/5411">issue 5411</a>)
    - <b>API change</b>: renamed the XSD type \c serialize() and \c deserialize() instance
      methods on \c XsdAbstractType, \c XsdBaseType, \c XsdSimpleType, \c XsdComplexType,
      \c XsdArrayType, and \c XsdElement to \c serializeValue() and \c deserializeValue()
      respectively. The previous names collided with \c Qore::Serializable's Java-bridge
      methods, causing \c java.lang.ClassFormatError: Duplicate method name "serialize" on
      \c qoremod.WSDL.XsdAbstractType when these classes were imported through the \c jni
      module. Direct callers of these methods (for example, custom SOAP wire-format code
      and array-serialization tests) must update to the new names. \c Qore::Serializable's
      \c serialize() / \c deserialize() byte-level API on \c WebService and the surrounding
      classes is unchanged.
    - fixed serializing a scalar value for a \c complexType declaring \c xs:anyAttribute; the hash
      wrapping the value in \c "^value^" narrowed its value type to the type of the scalar, so the
      \c "^attributes^" hash added afterwards was silently folded to an empty string, dropping
      \c "xsi:type" and any other attributes from the serialized message (and raising a
      \c RUNTIME-TYPE-ERROR when the \c soapenc:arrayType attribute was also required)

    @subsection wsdl_0_5_7 WSDL v0.5.7
    - moved WSDL class declarations inside the WSDL namespace for compatibility with %strong-encapsulation

    @subsection wsdl_0_5_6 WSDL v0.5.6
    <b>Namespace Handling Improvements</b>
    - fixed asymmetric namespace mapping in \c merge() that could cause lookup failures after prefix collisions
    - improved namespace prefix generation: increased from 3 to 6 characters for better readability
    - added \c tryGetInputNamespaceUri() method for safe namespace lookups without exceptions
    - added stack depth validation for \c pushTargetNamespace() / \c popTargetNamespace() and
      \c pushDefaultNamespace() / \c popDefaultNamespace() to catch mismatched push/pop errors
    - added SOAP encoding namespace validation in complexType array and extension handling
    - added @@assert() statements for precondition checking in namespace methods:
      - \c getUniquePrefix(): validates URI is provided
      - \c getOutputNamespaceUri(): validates prefix is provided
      - \c getOutputNamespacePrefix(): validates namespace URI is provided
      - \c getInputNamespaceUri(): validates namespace prefix is provided
      - \c doType(): validates type name and namespace prefix existence
      - push/pop namespace methods: validates stack integrity

    @subsection wsdl_0_5_5 WSDL v0.5.5
    - added length validation for dateTime and time value parsing to prevent crashes on malformed data
    - added thread-safety documentation to the @ref WSDL::WebService "WebService" class

    @subsection wsdl_0_5_4 WSDL v0.5.4
    - fixed a bug returning data provider type info for simpleTypes with union definitions
      (<a href="https://github.com/qorelanguage/qore/issues/4480">issue 4480</a>)

    @subsection wsdl_0_5_3 WSDL v0.5.3
    - fixed a bug handling \c complexType elements with a \c sequence and and \a any element
      (<a href="https://github.com/qorelanguage/qore/issues/4452">issue 4452</a>)
    - fixed a confusing bug in the error message for
      @ref WSDL::WSDLLib::getWebServiceFromUrl() "WSDLLib::getWebServiceFromUrl()" when the file could not be read
      (<a href="https://github.com/qorelanguage/qore/issues/4451">issue 4451</a>)
    - fixed bugs loading URLs with multiple imports of the same external XSD schema
      (<a href="https://github.com/qorelanguage/qore/issues/4449">issue 4449</a>)

    @subsection wsdl_0_5_2 WSDL v0.5.2
    - fixed a bug where the web service's name was not reported correctly by the
      @ref WSDL::WebService "WebService" object
      (<a href="https://github.com/qorelanguage/qore/issues/4437">issue 4437</a>)

    @subsection wsdl_0_5_1 WSDL v0.5.1
    - added support for the FileLocationHandler module

    @subsection wsdl_0_5 WSDL v0.5
    - added support for the data provider API

    @subsection wsdl_0_4 WSDL v0.4
    - added support for serializing and deserilizing WebService objects
      (<a href="https://github.com/qorelanguage/qore/issues/2793">issue 2793</a> and
      <a href="https://github.com/qorelanguage/qore/issues/1598">issue 1598</a>)

    @subsection wsdl_0_3_8 WSDL v0.3.8
    - fixed a bug handling complexTypes as part types
      (<a href="https://github.com/qorelanguage/qore/issues/2900">issue 2900</a>)
    - fixed bugs handling array types
      (<a href="https://github.com/qorelanguage/qore/issues/2899">issue 2899</a>)
    - added support for \c token and \c normalizedString types
      (<a href="https://github.com/qorelanguage/qore/issues/2859">issue 2859</a>)
    - fixed @ref WSDLLib::getWSDL() when passed a WSDL string with no XML preamble
      (<a href="https://github.com/qorelanguage/qore/issues/2857">issue 2857</a>)
    - fixed handling of XSD attribute names with non-word characters
      (<a href="https://github.com/qorelanguage/qore/issues/2856">issue 2856</a>)
    - fixed handling of \c simpleType definitions with \c union members
      (<a href="https://github.com/qorelanguage/qore/issues/2855">issue 2855</a>)

    @subsection wsdl_0_3_7 WSDL v0.3.7
    - implemented supoprt for handling SOAP faults in response messages with SOAP bindings
      (<a href="https://github.com/qorelanguage/qore/issues/2804">issue 2804</a>)
    - fixed an error in namespace resolution with nested namespaces
      (<a href="https://github.com/qorelanguage/qore/issues/2786">issue 2786</a>)
    - fixed a type error in example message generation that resulted in failed example message generation
      (<a href="https://github.com/qorelanguage/qore/issues/2782">issue 2782</a>)
    - fixed a bug in example message generation that resulted in invalid messages
      (<a href="https://github.com/qorelanguage/qore/issues/2752">issue 2752</a>)
    - implemented the @ref WSDL::wsdl_set_global_compat_empty_string_is_nothing()
    "wsdl_set_global_compat_empty_string_is_nothing"
      function and the \c "compat_empty_string_is_nothing" option for the
      @ref WSDL::WebService "WebService" class for backwards compatibility with older versions of the WSDL
      module (<a href="https://github.com/qorelanguage/qore/issues/2754">issue 2754</a>)
    - implemented the @ref WSDL::wsdl_set_global_compat_empty_string_is_nothing()
    "wsdl_set_global_compat_allow_any_header"
      function and the \c "compat_allow_any_header" option for the @ref WSDL::WebService "WebService" class
      for backwards compatibility with older versions of the WSDL module
      (<a href="https://github.com/qorelanguage/qore/issues/2765">issue 2765</a>)

    @subsection wsdl_0_3_6 WSDL v0.3.6
    - reimplmented operation to support multi binding, operation can be assigned to more bindings
    - support for HTTP binding and content-types, "^content-type^" attribute can identify content type to be used
    - extended SOAP binding serialization and deserialization with support to both body and header

    @subsection wsdl_0_3_5_1 WSDL v0.3.5.1
    - supress emitting a SOAPAction header in requests if the binding gives an empty string (<a href="https://github.com/qorelanguage/qore/issues/1226">issue 1226</a>)
    - updated @ref WSDL::WSOperation::serializeRequest() to allow the SOAPAction header to be overridden in each request (<a href="https://github.com/qorelanguage/qore/issues/1226">issue 1226</a>)
    - respect XML generation flags in request generation
    - fixed parsing empty base64Binary and hexBinary elements (<a href="https://github.com/qorelanguage/qore/issues/1227">issue 1227</a>)

    @subsection wsdl_0_3_5 WSDL v0.3.5
    - fixed many message serialization and deserialization issues
    - added @ref WSDL::WebService::getOperation()
    - allow for environment variable substitution in WSDLLib::getWSDL() when retrieving files
    - fixed charset=... header value
    - added @ref WSDL::WSMessageHelper
    - added @ref WSDL::WebService::getReport()

    @subsection wsdl_0_3_4 WSDL v0.3.4
    - updated to a user module

    @subsection wsdl_0_3_3 WSDL v0.3.3
    - added initial support for the anyAttribute element of complexType
    - added initial support for SOAP header processing
    - added initial support for multiple portType and bindings in a WSDL

    @subsection wsdl_0_3_2 WSDL v0.3.2
    - fixed bugs de/serializing negative values for "int" and "short"

    @subsection wsdl_0_3_1 WSDL v0.3.1
    - improved XSD imports and namespace handling

    @subsection wsdl_0_3_0 WSDL v0.3.0
    - implemented WSDLLib class of helper functions
    - implemented support for xsd import statements in WSDLs

    @subsection wsdl_0_2_0 WSDL v0.2.0
    - use parseXMLAsData() instead of parseXML()
    - implemented initial simpleType support
    - fixed xsd:date serialization and deserialization
*/

#! main WSDL namespace
public namespace WSDL {
#! this WSDL implementation version
public const version     = "0.3.6";

#! SOAP 1.1 envelope URI
public const SOAP_11_ENV  = "http://schemas.xmlsoap.org/soap/envelope/";
#! SOAP 1.2 envelope URI
public const SOAP_12_ENV  = "http://www.w3.org/2003/05/soap-envelope";

#! SOAP 1.1 namespace URI
public const SOAP_11_NS   = "http://schemas.xmlsoap.org/wsdl/soap/";

#! SOAP 1.2 namespace URI
public const SOAP_12_NS   = "http://schemas.xmlsoap.org/wsdl/soap12/";

#! XSD namespace URI
public const XSD_NS       = "http://www.w3.org/2001/XMLSchema";
#! XSI namespace URI
public const XSI_NS       = "http://www.w3.org/2001/XMLSchema-instance";

#! HTTP namespace URI
public const HTTP_NS      = "http://schemas.xmlsoap.org/wsdl/http/";
#! MIME namespace URI
public const MIME_NS      = "http://schemas.xmlsoap.org/wsdl/mime/";

#! soap 1.1 envelope namespaces
public const ENVELOPE_11_NS = (
    "soapenv:Envelope": (
        "^attributes^": (
            "xmlns:soapenv": SOAP_11_ENV,
            "xmlns:xsd": XSD_NS,
            "xmlns:xsi": XSI_NS,
        ),
    ),
);

#! soap 1.2 envelope namespaces
public const ENVELOPE_12_NS = (
    "soapenv:Envelope": (
        "^attributes^": (
            "xmlns:soapenv": SOAP_12_ENV,
          "xmlns:xsd": XSD_NS,
          "xmlns:xsi": XSI_NS,
        ),
    ),
);

#! SOAP "use" to "encoded" mappings
public const SoapUseMap = (
    "encoded": True,
    "literal": False,
);

#! SOAP "style" to "document" mappings
public const SoapStyleMap = (
    "document": True,
    "rpc": False,
);

#! soap encoding URI
public const SOAP_ENCODING = "http://schemas.xmlsoap.org/soap/encoding/";

#! mapping from Qore types to xsd types for xsd type "anyType"
public const any_type_map = (
    Type::String      : "string",
    Type::Int         : "long",
    Type::Boolean     : "boolean",
    Type::Date        : "dateTime",
    Type::Float       : "decimal",
    Type::NothingType : "string",
    Type::NullType    : "string",
    Type::Binary      : "base64Binary",
);

# error codes
const SOAP_SERIALIZATION_ERROR = "SOAP-SERIALIZATION-ERROR";
const SOAP_DESERIALIZATION_ERROR = "SOAP-DESERIALIZATION-ERROR";
const WSDL_ERROR = "WSDL-ERROR";

#! SOAP HTTP transport URI
const SOAP_TRANSPORT_HTTP = "http://schemas.xmlsoap.org/soap/http";

#! known/supported transports
public const SOAP_TRANSPORT = (
    SOAP_TRANSPORT_HTTP: True,
);

#! XOP (XML-binary Optimized Packaging) namespace URI
public const XOP_NS = "http://www.w3.org/2004/08/xop/include";

#! MTOM (Message Transmission Optimization Mechanism) content type
public const MTOM_CONTENT_TYPE = "application/xop+xml";

#! Minimum size in bytes for binary data to be optimized with MTOM
public const MTOM_THRESHOLD = 1024;

#! range of "byte" values (8 bits, signed)
public const RANGE_BYTE = (-128, 127);

#! range of "short" values (16 bits)
public const RANGE_SHORT = (-32768, 32767);

#! range of "int" values (32 bits)
public const RANGE_INT = (-2147483648, 2147483647);

# private global variables
our bool global_compat_empty_string_is_nothing;
our bool global_compat_allow_any_header;

#! sets the \c global_compat_empty_string_is_nothing variable to the given value to force the WSDL module to return a blank value for a required string field when the associated XML element is present as no value instead of an empty string for backwards compatibility with xml module 1.3
public sub wsdl_set_global_compat_empty_string_is_nothing(softbool val) {
    global_compat_empty_string_is_nothing = val;
}

#! sets the \c global_compat_allow_any_header variable to the given value to force the WSDL module to allow any SOAP header to be sent in SOAP messages for backwards compatibility with xml module 1.3
public sub wsdl_set_global_compat_allow_any_header(softbool val) {
    global_compat_allow_any_header = val;
}

#! contains helper methods for retrieving WSDLs from a URL
public class WSDLLib {
    #! Mime types recognized as SOAP messages
    const SoapMimeTypes = (MimeTypeSoapXml, MimeTypeXml, MimeTypeXmlApp);

    static string getSoapMimeType12(bool soap12) {
        return soap12 ? MimeTypeSoapXml : MimeTypeXml;
    }

    #! retrieves a local file and returns the file's contents as a string
    /** called by WSDLLib::getFileFromURL() in case the scheme is "file"
    */
    static data getFile(string fn, bool as_string = True) {
        *data rv = as_string ? ReadOnlyFile::readTextFile(fn) : ReadOnlyFile::readBinaryFile(fn);
        if (!exists rv) {
            throw "WSDL-LIB-ERROR", sprintf("file %y is empty or could not be read as a normal file", fn);
        }

        return rv;
    }

    #! normalizes a location to a scheme-prefixed string
    /** @note Applies environment variable substitution and default path resolution for file locations

        @since %WSDL 0.5.8
    */
    static string normalizeLocation(string url, string def_protocol = "file", *string def_path) {
        if (url =~ /^\w+:\/\//) {
            return url;
        }
        if (def_protocol != "file") {
            return def_protocol + "://" + url;
        }
        string path = url;
        # do environment variable substitution
        map path = replace(path, "\$" + $1, ENV.$1), (path =~ x/\$(\w+)/g);
        if (def_path && !absolute_path(path)) {
            path = def_path + DirSep + path;
        }
        return "file://" + path;
    }

    #! returns @ref True "True" if the given location has a URL scheme (ex: \c "http://...")
    /** @since %WSDL 0.5.8
    */
    static bool hasScheme(string location) {
        return location =~ /^[a-zA-Z][-+.a-zA-Z0-9]*:\/\//;
    }

    #! returns the base location to use when resolving locations relative to the given location
    /** @param location the location of a WSDL or XSD document

        @return the directory of the given path, or, if the location is a URL, the URL with the last path component
        removed

        @since %WSDL 0.5.8
    */
    static string getLocationBase(string location) {
        if (WSDLLib::hasScheme(location)) {
            # only the path component of the URL may be truncated; the authority must be kept intact
            (*string scheme, *string rest) = (location =~ x/^([a-zA-Z][-+.a-zA-Z0-9]*:\/\/)(.*)$/);
            *string base = (rest =~ x/^(.*)\/[^\/]*$/)[0];
            return exists base ? scheme + base : location;
        }
        return dirname(location);
    }

    #! resolves a possibly-relative location against a base location
    /** relative locations in \c schemaLocation and \c location attributes must be resolved against the location of
        the document containing the attribute and not against the location of the top-level WSDL document

        @param location the location to resolve; if it has a URL scheme or is an absolute path, it is returned
        unchanged
        @param base the base location as returned by
        @ref WSDL::WSDLLib::getLocationBase() "WSDLLib::getLocationBase()"; if not present, then \a location is
        returned unchanged

        @return the resolved location

        @since %WSDL 0.5.8
    */
    static string resolveLocation(string location, *string base) {
        if (!base || WSDLLib::hasScheme(location) || absolute_path(location)) {
            return location;
        }
        if (WSDLLib::hasScheme(base)) {
            # resolve relative to the base URL; only the path component of the URL may be normalized
            (*string scheme, *string rest) = (base =~ x/^([a-zA-Z][-+.a-zA-Z0-9]*:\/\/)(.*)$/);
            (*string authority, *string path) = (rest =~ x/^([^\/]*)(\/.*)?$/);
            return scheme + authority + normalize_dir((path ?? "") + "/" + location, "/");
        }
        return normalize_dir(base + DirSep + location);
    }

    #! retrieves a file from a URL with HTTP and returns the file's contents as a string
    /** called by WSDLLib::getFileFromURL() in case the scheme is "http"
    */
    static string getHTTP(string url, *string path, *HTTPClient hc, *hash<auto> headers, bool as_string = True) {
        if (hc) {
            hc.setURL(url);
        } else {
            hc = new HTTPClient(("url": url));
        }
        string body;
        try {
            body = hc.get(path ? path : "/", headers);
        } catch (hash<ExceptionInfo> ex) {
            throw ex.err, sprintf("error loading WSDL from %y: %s", url, ex.desc), ex.arg;
        }
        return as_string ? body : binary(body);
    }

    #! retrieves a file from a URL with the FTP protocol and returns the file's contents as binary or string data
    /** called by WSDLLib::getFileFromURL() in case the scheme is "ftp"
    */
    static data getFTP(string url, string path, bool as_string = True) {
        string file = basename(path);
        if (!file) {
            throw "WSDL-LIB-ERROR", sprintf("missing file name in URL %y", url);
        }

        FtpClient f(url);
        f.connect();

        string dir = dirname(path);
        if (dir) {
            f.cwd(dir);
        }

        return as_string ? f.getAsString(file) : f.getAsBinary(file);
    }

    #! retrieves a file from a URL
    /** in case the URL is actually a file path, environment variable substitution
        is performed on the path string

        @note uses the \c FileLocationHandler module to retrieve file data for all schemes except \c "file://" and
        \c "http(s)://", which uses @ref WSDL::WSDLLib::getFileFromUrl() "WSDLLib::getFileFromUrl()" and
        @ref WSDL::WSDLLib::getHTTP() "WSDLLib::getHTTP()" respectively for backwards compatibility
     */
    static data getFileFromURL(string url, string def_protocol = "file", *HTTPClient http_client,
            *hash<auto> http_headers, bool as_string = True, *string def_path, *reference new_def_path) {
        try {
            return WSDLLib::getFileFromURL(url, parse_url(url), def_protocol, http_client, http_headers, as_string,
                def_path, \new_def_path);
        } catch (hash<ExceptionInfo> ex) {
            # re-throw HTTP errors - don't fall back to FileLocationHandler for these
            if (ex.err =~ /^HTTP/) {
                rethrow;
            }
            # see if a scheme is given in the location
            if (url !~ /^\w+:\/\//) {
                url = def_protocol + "://" + url;
            }
            return FileLocationHandler::getFileFromLocation(as_string, url);
        }
    }

    #! retrieves a file from an already-parsed URL
    /** in case the URL is actually a file path, environment variable substitution
        is performed on the path string

        @note uses the \c FileLocationHandler module to retrieve file data for all schemes except \c "file://" and
        \c "http(s)://", which uses @ref WSDL::WSDLLib::getFileFromUrl() "WSDLLib::getFileFromUrl()" and
        @ref WSDL::WSDLLib::getHTTP() "WSDLLib::getHTTP()" respectively for backwards compatibility
     */
    static data getFileFromURL(string url, hash<auto> u, string def_protocol = "file", *HTTPClient http_client,
            *hash<auto> http_headers, bool as_string = False, *string def_path, *reference new_def_path) {
        bool used_def_protocol;
        if (!exists u.protocol) {
            u.protocol = def_protocol;
            used_def_protocol = True;
        }

        switch (u.protocol) {
            case "file": {
                string path;
                if (u.host) {
                    path = u.host;
                }
                if (u.path) {
                    if (path) {
                        path += DirSep;
                    }
                    path += u.path;
                }
                # do environment variable substitution
                map path = replace(path, "\$" + $1, ENV.$1), (path =~ x/\$(\w+)/g);

                if (def_path && !absolute_path(path)) {
                    path = normalize_dir(def_path + DirSep + path);
                }
                # the base location must always be updated, otherwise nested relative references in
                # externally-referenced schemas are resolved against the wrong directory
                new_def_path = dirname(path);
                return WSDLLib::getFile(path, as_string);
            }

            case /^http(s)?$/:
                # allow relative references in externally-referenced schemas to be resolved
                new_def_path = WSDLLib::getLocationBase(url);
                return WSDLLib::getHTTP(url, u.path, http_client, http_headers, as_string);

            default:
                if (used_def_protocol) {
                    url = def_protocol + "://" + url;
                }
                return FileLocationHandler::getFileFromLocation(as_string, url);
        }
    }

    #! returns the argument
    static WebService getWSDL(WebService wsdl) {
        return wsdl;
    }

    #! returns a WSDL string from a file name, optional HTTPClient object and optional header hash
    /** in case the \a wsdl argument is actually a file path, environment variable substitution
        is performed on the path string
     */
    static string getWSDL(string wsdl, *HTTPClient http_client, *hash<auto> http_headers, *reference new_def_path) {
        if (wsdl =~ /^</) {
            return wsdl;
        }
        return WSDLLib::getFileFromURL(wsdl, "file", http_client, http_headers, NOTHING, NOTHING, \new_def_path);
    }

    #! returns a WebService object from a URL and other optional arguments
    /** @param the URL to use to retrieve the file, the \c "file://", \c "http://", \c "https://", and \c "ftp://" schemes are supported, if no scheme is present, then \c "file://" is assumed
        @param http_client an optional HTTPClient object to use to retrieve external schemas, if no HTTPClient object is passed and one is needed, an HTTPClient object will be created implicitly
        @param http_headers any HTTP headers to send with requests when retrieving external XSD schemas
    */
    static WebService getWebServiceFromUrl(string url, *HTTPClient http_client, *hash<auto> http_headers) {
        string def_path;
        string wsdl = WSDLLib::getWSDL(url, http_client, http_headers, \def_path);
        return new WebService(wsdl, {"def_path": def_path, "http_client": http_client, "http_headers": http_headers});
    }

    #! takes a hash representation of a SOAP message and handles multipart messages, checks the content-type, and handles hrefs in the message
    static hash<auto> parseMultiPartSOAPMessage(hash<auto> msg) {
        if (exists msg."_qore_multipart") {
            if (msg."_qore_multipart" != "related") {
                throw "SOAP-MESSAGE-ERROR", sprintf("don't understand multipart/%s messages; expected multipart/related", msg."_qore_multipart");
            }

            auto bdry = msg."_qore_multipart_boundary";
            if (!bdry.val()) {
                throw "SOAP-MESSAGE-ERROR", sprintf("multipart message received without multipart boundary; headers: %y", msg - "body");
            }

            hash<auto> mpmsg;
            list<string> l = split("\r\n--" + bdry, msg.body);

            for (int i = 1; i < (elements l - 1); ++i) {
                string m = l[i];

                int ie = index(m, "\r\n\r\n");
                if (ie == -1) {
                    throw "SOAP-MESSAGE-ERROR", sprintf("part %d has no headers: %y", i, m);
                }
                hash<auto> hh;
                foreach string hl in (split("\r\n", substr(m, 2, ie))) {
                    trim hl;
                    (string hi, auto ignore, string ha) = hl =~ x/^(.*):([ \t])*(.*)$/;
                    hi = tolower(hi);
                    #printf("hl: %y hi: %y ha: %y\n", hl, hi, ha);exit();
                    hh{hi} = ha;
                }
                if (!exists hh."content-id") {
                    throw "SOAP-MESSAGE-ERROR", sprintf("expecting part header Content-ID in part %d; headers: %y",
                        i, hh);
                }

                auto b;
                if (hh."content-transfer-encoding" == "binary") {
                    # unfortunately we have to do some tricks to get the binary data out here
                    # FIXME: tricks probably not necessary with qore 0.8.1+
                    m = force_encoding(m, "ascii");
                    # recalculate byte offset
                    ie = index(m, "\r\n\r\n");
                    #printf("ie: %d m: %d\n", ie, strlen(m));exit();
                    b = binary(substr(m, ie + 4));

                    #File f(); f.open2("t.bin", O_CREAT|O_WRONLY|O_TRUNC); f.write(b); exit();
                } else {
                    b = substr(m, ie + 4);

                    if (hh."content-type" =~ /charset=/) {
                        string c = (hh."content-type" =~ x/charset=([^;]+)/)[0];
                        b = force_encoding(b, c);
                    }
                }

                if (hh."content-id" !~ /^\<.*\>$/) {
                    throw "SOAP-MESSAGE-ERROR", sprintf("expected part ID to have the following format: <id>, "
                        "instead got %s", hh."content-id");
                }

                hash<auto> p = (
                    "hdr": hh,
                    "body": b,
                );

                if ((!exists msg."_qore_multipart_start" && i == 1)
                    || (exists msg."_qore_multipart_start" && msg."_qore_multipart_start" == hh."content-id")) {
                    mpmsg.body = p;
                } else {
                    string id = substr(hh."content-id", 1, -1);
                    mpmsg.part{id} = p;
                }
            }

            # Detect MTOM/XOP messages
            bool is_mtom = mpmsg.body.hdr."content-type" =~ /application\/xop\+xml/i;

            return {
                'content-type': mpmsg.body.hdr."content-type",
                'header': msg.header + mpmsg.body.hdr,
                'body': mpmsg.body.body,
                'parts': mpmsg.part,
                'is_mtom': is_mtom,
            };
        } else {
            return {
                'content-type': msg."_qore_orig_content_type",
                'header': msg.header,
                'body': msg.body,
            };
        }
    }

    #! Checks if an element is an xop:Include element by verifying the namespace
    /** @param key the element key (may include prefix like "xop:Include")
        @param node the element node (hash with attributes)
        @return True if this is a valid xop:Include element
    */
    private static bool isXopIncludeElement(string key, auto node) {
        # Determine local name and optional prefix from the element key
        string prefix;
        string local;
        if (key =~ /^([^:]+):(.*)$/) {
            prefix = ($1)[0];
            local = ($1)[1];
        } else {
            prefix = "";
            local = key;
        }

        if (local != "Include") {
            return False;
        }

        if (!node || node.typeCode() != NT_HASH) {
            return False;
        }

        *hash<auto> attrs = node."^attributes^";
        if (!attrs) {
            return False;
        }

        # If there is a prefix, require a matching xmlns:<prefix> declaration
        if (prefix) {
            string ns_attr = "xmlns:" + prefix;
            return attrs{ns_attr} == XOP_NS;
        }

        # No prefix: require default namespace to be the XOP namespace
        return attrs{"xmlns"} == XOP_NS;
    }

    #! Resolves xop:Include references in an XML data structure
    /** @param data reference to the XML data structure to process
        @param parts hash of MIME parts keyed by content-id
    */
    static substXopInclude(reference<auto> data, hash<auto> parts) {
        if (data.typeCode() == NT_HASH) {
            # Check for xop:Include element
            foreach string key in (keys data) {
                if ((key =~ /:Include$/ || key == "Include") && isXopIncludeElement(key, data{key})) {
                    # This is a verified xop:Include element
                    *hash<auto> attrs = data{key}."^attributes^";
                    if (attrs && attrs.href) {
                        string href = attrs.href;
                        if (href =~ /^cid:/) {
                            # Extract content-id from cid: URI
                            string cid = substr(href, 4);  # Remove "cid:" prefix
                            if (parts{cid}) {
                                # Replace the xop:Include with the binary data
                                data = parts{cid}.body;
                                return;
                            }
                        }
                    }
                } else {
                    # Recursively process nested structures
                    WSDLLib::substXopInclude(\data{key}, parts);
                }
            }
        } else if (data.typeCode() == NT_LIST) {
            for (int i = 0; i < data.size(); ++i) {
                WSDLLib::substXopInclude(\data[i], parts);
            }
        }
    }

    #! Creates an MTOM/XOP multipart message from XML and binary attachments
    /** @param xml the XML SOAP message body
        @param attachments list of hashes with keys: 'cid' (content-id), 'content_type', 'data' (binary)
        @param boundary optional multipart boundary string
        @return hash with 'content_type' and 'body' keys for the multipart message
    */
    static hash<auto> packageMtom(string xml, list<hash<auto>> attachments, *string boundary) {
        if (!boundary) {
            boundary = "----=_Part_" + get_random_string(20);
        }

        # Build the root part (XOP document)
        string root_cid = "root.message@qore.org";

        # Build all parts into a list and join at the end
        list<auto> parts = ();

        # Root part header and content
        string root_header = "--" + boundary + "\r\n";
        root_header += "Content-Type: application/xop+xml; charset=utf-8; type=\"text/xml\"\r\n";
        root_header += "Content-Transfer-Encoding: 8bit\r\n";
        root_header += "Content-ID: <" + root_cid + ">\r\n";
        root_header += "\r\n";
        root_header += xml + "\r\n";
        parts += root_header;

        # Add each binary attachment
        foreach hash<auto> att in (attachments) {
            string att_header = "--" + boundary + "\r\n";
            att_header += "Content-Type: " + (att.content_type ?? "application/octet-stream") + "\r\n";
            att_header += "Content-Transfer-Encoding: binary\r\n";
            att_header += "Content-ID: <" + att.cid + ">\r\n";
            att_header += "\r\n";
            parts += att_header;
            parts += att.data;
            parts += "\r\n";
        }

        # Close the multipart message
        parts += "--" + boundary + "--\r\n";

        # Join all parts - convert to binary if any binary parts exist
        bool has_binary = False;
        foreach auto p in (parts) {
            if (p.typeCode() == NT_BINARY) {
                has_binary = True;
                break;
            }
        }

        auto body;
        if (has_binary) {
            body = binary();
            foreach auto p in (parts) {
                if (p.typeCode() == NT_BINARY) {
                    body += p;
                } else {
                    body += binary(p);
                }
            }
        } else {
            body = parts.join("");
        }

        return {
            "content_type": sprintf("multipart/related; boundary=\"%s\"; type=\"application/xop+xml\"; start=\"<%s>\"",
                boundary, root_cid),
            "body": body,
        };
    }

    #! returns True is the message has a SOAP mime type
    static bool isSOAPMessage(hash<auto> msg) {
        return WsdlLibPriv::isContentType(msg."content-type", SoapMimeTypes);
    }

    #! returns True if the message is an MTOM/XOP message
    static bool isMtomMessage(hash<auto> msg) {
        return msg."content-type" =~ /application\/xop\+xml/i;
    }

    /**!
    takes a hash representation returned by parseMultiPartSOAPMessage and parses it to a Qore data structure, checks the content-type, and handles hrefs in the message.
    Operation is not yet known if SoapAction header is not presented
    */
    static *hash<auto> parseSOAPMessage(hash<auto> msg) {
        if (!msg.body) {
            hash<auto> h."content-type" = msg."content-type" ?? "text/plain";
            h.body = NOTHING;
            return h;
        } else if (WSDLLib::isSOAPMessage(msg) || WSDLLib::isMtomMessage(msg)) {
            hash<auto> xmldata;
            if (msg.body) {
                xmldata = parse_xml(msg.body);
            }
            if (msg.parts) {
                # For MTOM messages, resolve xop:Include references
                if (msg.is_mtom) {
                    WSDLLib::substXopInclude(\xmldata, msg.parts);
                } else {
                    # For traditional multipart messages, parse entire data structure to find "href"s
                    WSDLLib::substHref(\xmldata, msg.parts);
                }
            }
            return xmldata;
        } else {
            string ct = msg."content-type";
            hash<auto> h."content-type" = (ct =~ x/^([^;]+)/)[0];
            if (ct =~ /charset=/) {
                string c = (ct =~ x/charset=([^;]+)/)[0];
                h.body = force_encoding(msg.body, c);
            } else {
                h.body = binary(msg.body);  # needed or is it already ?
            }
            return h;
        }
    }

    private static processHref(reference xmldata, string hr, hash<auto> parts) {
        if (hr !~ /^cid:/)
            throw "SOAP-MESSAGE-ERROR", sprintf("messages references non-local part %y; cannot handle non-local parts", hr);
        hr = substr(hr, 4);
        if (!exists parts{hr})
            throw "SOAP-MESSAGE-ERROR", sprintf("message references non-existent part %y", hr);
        xmldata = parts{hr}.body;
    }

    private static substHref(reference xmldata, hash<auto> parts) {
        foreach string k in (keys xmldata) {
            if (exists xmldata{k}."^attributes^".href)
                WSDLLib::processHref(\xmldata{k}, xmldata{k}."^attributes^".href, parts);
            else if (exists xmldata{k}.href)
                WSDLLib::processHref(\xmldata{k}, xmldata{k}.href, parts);
            else if (xmldata{k}.typeCode() == NT_LIST) {
                foreach auto e in (\xmldata{k})
                    WSDLLib::substHref(\e, parts);
            } else if (xmldata{k}.typeCode() == NT_HASH)
                WSDLLib::substHref(\xmldata{k}, parts);
        }
    }
}

# private, nmon-exported class
class WsdlLibPriv {
    static bool isContentType(string ct, list<auto> MimeTypes) {
        ct = ltrim(ct);
        foreach string sct in (MimeTypes) {
            # Content-Type := type "/" subtype *[";" parameter] ... so we can test if string is starting at index 0
            if (bindex(ct, sct) == 0)
                return True;
        }
        return False;
    }

    static checkContentType(string ct, list<auto> MimeTypes) {
        if (!WsdlLibPriv::isContentType(ct, MimeTypes)) {
            throw "SOAP-MESSAGE-ERROR", sprintf("don't know how to handle content-type %y (expecting one of: %y)", ct, MimeTypes);
        }
    }
}

#! base class with helper methods for XSD data processing
public class XsdBase inherits Qore::Serializable {
    static removeNS(reference v) {
        foreach hash<auto> h in (\v) {
            foreach string k in (keys h) {
                (*string ns, *string name) = k =~ x/([^:]+):([^:]+)/;
                if (ns) {
                    switch (h{k}.typeCode()) {
                        case NT_HASH: h{k}.ns = ns; break;
                        case NT_LIST: h{k} = map $1 + ("ns": ns), h{k}; break;
                    }
                    if (h{name}) {
                        softlist<auto> l = h{name};
                        l += remove h{k};
                        h{name} = l;
                    } else
                        h{name} = remove h{k};
                }
            }
        }
    }

    static removeNS2(reference v) {
        foreach hash<auto> h in (\v) {
            foreach string k in (keys h) {
                (*string ns, *string name) = k =~ x/([^:]+):([^:]+)/;
                if (ns) {
                    switch (h{k}.typeCode()) {
                        case NT_HASH: h{k}.".ns" = ns; break;
                        case NT_LIST: h{k} = map $1 + (".ns": ns), h{k}; break;
                    }
                    if (h{name}) {
                        softlist<auto> l = h{name};
                        l += remove h{k};
                        h{name} = l;
                    } else
                        h{name} = remove h{k};
                }
            }
        }
    }

    #! Removes namespace prefixes from all keys in the given hash
    /** This function is designed for flat attribute hashes where values may be strings.
        Unlike removeNS(), this processes keys directly regardless of value types.
    */
    static removeNSKeys(reference<*hash<auto>> h) {
        if (!h) {
            return;
        }
        foreach string k in (keys h) {
            (*string ns, *string name) = k =~ x/([^:]+):([^:]+)/;
            if (ns && name) {
                if (exists h{name}) {
                    # If the unqualified key already exists, make it a list
                    softlist<auto> l = h{name};
                    l += remove h{k};
                    h{name} = l;
                } else {
                    h{name} = remove h{k};
                }
            }
        }
    }
}

#! base class for XSD data classes
public class XsdData inherits WSDL::XsdBase {
    auto getValue(*hash<auto> mrh, auto val) {
        if (exists val."^attributes^".href) {
            string href = substr(val."^attributes^".href, 1);

            if (!exists mrh.mrh{href})
                throw "INVALID-REFERENCE", sprintf("multiRef id: %y does not exist", href);

            return mrh.mrh{href};
        }
        return val;
    }
}

#! base class for XSD classes with a "name" attribute
public class XsdNamedData inherits WSDL::XsdData {
    public {
        # name of object
        string name;
        #! input namespace prefix (if any given)
        *string ns;
        #! descriptive name flag
        bool descriptive_name;
    }

    constructor(string n_name, string n_ns) {
        name = n_name;
        ns = n_ns;
        # if the name has a space in it, then it's a descriptive name
        descriptive_name = (name =~ / /);
    }

    constructor(reference e, *string desc_name) {
        WSDL::XsdBase::removeNS(\e);
        *hash<auto> a = e."^attributes^";
        if (a.name)
            name = a.name;
        else if (a.ref) {
            # remove namespace
            (*string ns, *string n_name) = a.ref =~ x/([^:]+):([^:]+)/;
            name = n_name ?? a.ref;
        } else
            name = desc_name ?? "<unnamed type>";
        # if the name has a space in it, then it's a descriptive name
        descriptive_name = (name =~ / /);
    }

    string getName() {
        return name;
    }

    *string getInputNamespacePrefix() {
        return ns;
    }

    bool hasRealName() {
        return !descriptive_name;
    }
}

public class XsdAbstractType inherits WSDL::XsdNamedData {
    public {
        #! reference to namespaces
        Namespaces nsc;

        #! my namespace output prefix
        string ons;
    }

    constructor(reference e, Namespaces nsc, *string desc_name) : XsdNamedData(\e, desc_name) {
        self.nsc := nsc;
        resolveNamespace();
    }

    constructor(string name, string ns, Namespaces nsc) : XsdNamedData(name, ns) {
        self.nsc := nsc;
        resolveNamespace();
    }

    private resolveNamespace() {
        if (!ns) {
            *string tns = nsc.getTargetNamespaceUri();
            if (!tns)
                throw "WSDL-NAMESPACE-ERROR", sprintf("input namespace for %s %y was not given and there is no current target namespace", self.className(), name);
            ons = nsc.getOutputNamespacePrefix(tns);
        } else
            ons = nsc.translateOutputNamespacePrefix(ns);
        #printf("DEBUG: type %y ns: %y ons: %y\n", name, ns, ons);
    }

    checkExtends(XsdAbstractType t, string ename) {
        throw SOAP_SERIALIZATION_ERROR, sprintf("explicit type %y given for element %y, type %y, however the types are not compatible", name, ename, t.name);
    }

    string getNameWithNS() {
        return ons + ":" + name;
    }

    bool isNillable() {
        return False;
    }

    bool isRequired() {
        return True;
    }

    bool requiresValue() {
        return !isNillable() && isRequired();
    }

    string getOutputNamespacePrefix() {
        return ons;
    }

    *list<auto> getAllowedValues() {
        # this method intentionally left empty
    }

    abstract auto serializeValue(Namespaces nsc, auto val, *softbool omitType);
    abstract auto deserializeValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val);
    abstract AbstractDataProviderType getDataProviderType();

    #! returns the \c whiteSpace processing that applies to this type
    /** @return one of \c "preserve", \c "replace", or \c "collapse"

        @since %WSDL 0.5.8
    */
    string getWhiteSpace() {
        return "preserve";
    }
}

#! data provider type for \c xs:boolean values
/** accepts any value that can be converted to a boolean, but converts string values according to the XSD boolean
    lexical space, so that \c "false" and \c "0" are converted to @ref False "False"

    @note a plain \c softbool type cannot be used for XSD booleans, because %Qore's boolean conversion converts any
    non-empty string to @ref True "True", which would silently turn the XSD value \c "false" into \c "true"

    @since %WSDL 0.5.8
*/
public class XsdBooleanDataType inherits QoreDataType {
    constructor() : QoreDataType(SoftBoolType) {
    }

    auto acceptsValue(auto value) {
        # parse string values according to the XSD boolean lexical space before the type conversion
        if (value.typeCode() == NT_STRING) {
            value = parse_boolean(value);
        }
        return QoreDataType::acceptsValue(value);
    }
}

#! the data provider type for \c xs:boolean values
/** @since %WSDL 0.5.8
*/
public const XsdBooleanType = new WSDL::XsdBooleanDataType();

#! class for XSD base types
public class XsdBaseType inherits WSDL::XsdAbstractType {
    public {
        #! the built-in types whose \c whiteSpace value is not \c "collapse"
        /** XSD 1.0 part 2: \c xs:string has \c whiteSpace \c "preserve" and \c xs:normalizedString has
            \c "replace"; every other built-in atomic type has \c "collapse", as does \c xs:token and all the
            types derived from it

            @since %WSDL 0.5.8
        */
        const WhiteSpaceMap = {
            "string": "preserve",
            "anyType": "preserve",
            "anySimpleType": "preserve",
            "normalizedString": "replace",
        };
    }

    constructor(string t, Namespaces nsc, string ns = "xsd") : XsdAbstractType(t, ns, nsc) {
    }

    #! returns the \c whiteSpace processing that applies to this built-in type
    /** @since %WSDL 0.5.8
    */
    string getWhiteSpace() {
        return XsdBaseType::WhiteSpaceMap{name} ?? "collapse";
    }

    auto serializeValue(Namespaces nsc, auto val, *softbool omitType) {
        *hash<auto> comments;
        if (val.typeCode() == NT_HASH) {
            foreach string k in (keys val) {
                if (k =~ /^\^comment/) {
                    comments{k} = val{k};
                }
            }
            val = val."^value^";
        }
        # issue #5411: apply "whiteSpace" processing to the lexical value
        if (val.typeCode() == NT_STRING) {
            val = XsdSimpleType::normalizeWhiteSpace(val, getWhiteSpace());
        }
        *string type;
        # set type according to Qore type if xsd type is anyType
        if (name == "anyType") {
            # we have to specify the type in this case
            omitType = False;
            type = any_type_map{val.type()};
            if (!type)
                throw SOAP_SERIALIZATION_ERROR, sprintf("cannot serialize xsd type anyType from Qore type %y", val.type());
        } else {
            type = name;
        }
        switch (type) {
            case "byte": {
                int v = int(val);
                if (v < RANGE_BYTE[0] || v > RANGE_BYTE[1])
                    throw SOAP_SERIALIZATION_ERROR, sprintf("value %d is out of range for type %y", v, type);
                break;
            }

            case "short": {
                int v = int(val);
                if (v < RANGE_SHORT[0] || v > RANGE_SHORT[1])
                    throw SOAP_SERIALIZATION_ERROR, sprintf("value %d is out of range for type %y", v, type);
                break;
            }

            case "int": {
                int v = int(val);
                if (v < RANGE_INT[0] || v > RANGE_INT[1])
                    throw SOAP_SERIALIZATION_ERROR, sprintf("value %d is out of range for type %y", v, type);
                break;
            }

            case "unsignedByte": {
                int v = int(val);
                if ((v & 0xff) != v)
                    throw SOAP_SERIALIZATION_ERROR, sprintf("value %d is out of range for type %y", v, type);
                if (v < 0)
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y does not accept negative values (value supplied: %d)", type, v);
                break;
            }

            case "unsignedShort": {
                int v = int(val);
                if (v < 0 || v > RANGE_SHORT[1])
                    throw SOAP_SERIALIZATION_ERROR, sprintf("value %d is out of range for type %y", v, type);
                break;
            }

            case "unsignedInt": {
                int v = int(val);
                if (v < 0 || v > RANGE_INT[1])
                    throw SOAP_SERIALIZATION_ERROR, sprintf("value %d is out of range for type %y", v, type);
                break;
            }

            case "unsignedLong": {
                int v = int(val);
                if (v < 0)
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y does not accept negative values (value supplied: %d)", type, v);
                break;
            }

            case "negativeInteger": {
                int v = int(val);
                if (v >= 0)
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y only accepts negative values (value supplied: %d)", name, v);
                break;
            }

            case "nonNegativeInteger": {
                int v = int(val);
                if (v < 0)
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y only accepts non-negative values (value supplied: %d)", name, v);
                break;
            }

            case "nonPositiveInteger": {
                int v = int(val);
                if (v > 0)
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y only accepts non-positive values (value supplied: %d)", name, v);
                break;
            }

            case "positiveInteger": {
                int v = int(val);
                if (v <= 0)
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y only accepts positive values (value supplied: %d)", type, v);
                break;
            }

            case "date":
                val = format_date("YYYY-MM-DD", date(val));
                break;

            case "dateTime":
                val = date(val).format("IF");
                break;

            case "boolean":
                # use parse_boolean() so that string values are interpreted according to their content; a simple
                # boolean conversion would turn the string "false" into "true", as any non-empty string is True
                val = parse_boolean(val) ? "true" : "false";
                break;

            case "time":
                val = format_date("HH:mm:SS.ms", date(val));
                break;

            case "base64Binary":
                val = make_base64_string(val);
                break;

            case "hexBinary":
                val = make_hex_string(val);
                break;

            case "binary":
                # used for HTTP binding only
                val = binary(val);
                break;

            case "token":
                if (!val.strp()) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y only accepts values that are convertible to strings; type %y supplied", type, val.type());
                }
                # XML processor should remove line feeds, carriage returns, tabs, leading and trailing spaces, and multiple spaces
                val = trim(val.toString());
                val =~ s/  +/ /g;
                break;

            case "normalizedString":
                if (!val.strp()) {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y only accepts values that are convertible to strings; type %y supplied", type, val.type());
                }
                # XML processor should remove line feeds, carriage returns, and tab characters
                val = val.toString();
                val =~ s/[\n\r\t]//g;
                break;

            case "string":
            case "anyURI":
            case "language":
            case "Name":
            case "NCName":
            case "QName":
            case "NMTOKEN":
            case "NMTOKENS":
            case "ID":
            case "IDREF":
            case "IDREFS":
            case "ENTITY":
            case "ENTITIES":
            case "integer":
            case "long":
            case "decimal":
                # pass through without transformation
                break;

            case "float":
            case "double":
                # Handle IEEE 754 float/double
                # Check for special values
                if (val.typeCode() == NT_STRING) {
                    switch (val) {
                        case "INF":
                        case "-INF":
                        case "NaN":
                            # These are valid lexical representations, pass through
                            break;
                        default:
                            # Convert string to float
                            val = float(val);
                    }
                } else {
                    # Convert to float
                    val = float(val);
                }
                break;

            case "duration":
                # ISO 8601 duration: P[n]Y[n]M[n]DT[n]H[n]M[n]S
                if (val.typeCode() == NT_STRING) {
                    # Validate duration format
                    if (val !~ /^-?P(\d+Y)?(\d+M)?(\d+D)?(T(\d+H)?(\d+M)?(\d+(\.\d+)?S)?)?$/) {
                        throw SOAP_SERIALIZATION_ERROR, sprintf("value %y is not a valid ISO 8601 duration for type %y", val, type);
                    }
                    # Reject empty durations: "P", "-P", "PT", "-PT"
                    if (val =~ /^-?PT?$/) {
                        throw SOAP_SERIALIZATION_ERROR, sprintf("value %y is an empty ISO 8601 duration (missing components) for type %y", val, type);
                    }
                } else if (val.typeCode() == NT_DATE) {
                    # Convert date/time duration to ISO 8601 format
                    # For relative dates, format appropriately
                    int years = get_years(val);
                    int months = get_months(val);
                    int days = get_days(val);
                    int hours = get_hours(val);
                    int minutes = get_minutes(val);
                    int seconds = get_seconds(val);

                    string dur = "P";
                    if (years) {
                        dur += sprintf("%dY", years);
                    }
                    if (months) {
                        dur += sprintf("%dM", months);
                    }
                    if (days) {
                        dur += sprintf("%dD", days);
                    }
                    if (hours || minutes || seconds) {
                        dur += "T";
                        if (hours) {
                            dur += sprintf("%dH", hours);
                        }
                        if (minutes) {
                            dur += sprintf("%dM", minutes);
                        }
                        if (seconds) {
                            dur += sprintf("%dS", seconds);
                        }
                    }
                    if (dur == "P") {
                        dur = "PT0S";  # Zero duration
                    }
                    val = dur;
                } else {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y requires a string or date value; type %y supplied", type, val.type());
                }
                break;

            case "gYear":
                # Format: YYYY with optional timezone
                if (val.typeCode() == NT_DATE) {
                    val = format_date("YYYY", date(val));
                } else if (val.typeCode() == NT_STRING) {
                    # Validate format
                    if (val !~ /^-?\d{4,}(Z|[+-]\d{2}:\d{2})?$/) {
                        throw SOAP_SERIALIZATION_ERROR, sprintf("value %y is not a valid gYear for type %y", val, type);
                    }
                } else {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y requires a date or string value; type %y supplied", type, val.type());
                }
                break;

            case "gYearMonth":
                # Format: YYYY-MM with optional timezone
                if (val.typeCode() == NT_DATE) {
                    val = format_date("YYYY-MM", date(val));
                } else if (val.typeCode() == NT_STRING) {
                    # Validate format
                    if (val !~ /^-?\d{4,}-\d{2}(Z|[+-]\d{2}:\d{2})?$/) {
                        throw SOAP_SERIALIZATION_ERROR, sprintf("value %y is not a valid gYearMonth for type %y", val, type);
                    }
                } else {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y requires a date or string value; type %y supplied", type, val.type());
                }
                break;

            case "gMonthDay":
                # Format: --MM-DD with optional timezone
                if (val.typeCode() == NT_DATE) {
                    val = format_date("--MM-DD", date(val));
                } else if (val.typeCode() == NT_STRING) {
                    # Validate format
                    if (val !~ /^--\d{2}-\d{2}(Z|[+-]\d{2}:\d{2})?$/) {
                        throw SOAP_SERIALIZATION_ERROR, sprintf("value %y is not a valid gMonthDay for type %y", val, type);
                    }
                } else {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y requires a date or string value; type %y supplied", type, val.type());
                }
                break;

            case "gMonth":
                # Format: --MM with optional timezone
                if (val.typeCode() == NT_DATE) {
                    val = format_date("--MM", date(val));
                } else if (val.typeCode() == NT_STRING) {
                    # Validate format
                    if (val !~ /^--\d{2}(Z|[+-]\d{2}:\d{2})?$/) {
                        throw SOAP_SERIALIZATION_ERROR, sprintf("value %y is not a valid gMonth for type %y", val, type);
                    }
                } else {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y requires a date or string value; type %y supplied", type, val.type());
                }
                break;

            case "gDay":
                # Format: ---DD with optional timezone
                if (val.typeCode() == NT_DATE) {
                    val = format_date("---DD", date(val));
                } else if (val.typeCode() == NT_STRING) {
                    # Validate format
                    if (val !~ /^---\d{2}(Z|[+-]\d{2}:\d{2})?$/) {
                        throw SOAP_SERIALIZATION_ERROR, sprintf("value %y is not a valid gDay for type %y", val, type);
                    }
                } else {
                    throw SOAP_SERIALIZATION_ERROR, sprintf("type %y requires a date or string value; type %y supplied", type, val.type());
                }
                break;

            default:
                throw SOAP_SERIALIZATION_ERROR, sprintf("don't know how to serialize type %y", type);
        }

        #printf("DEBUG: FORCE: type: %y, nstype: %y, val: %y\n", type, nstype, val);
        if (omitType) {
            if (comments) {
                return comments + (
                    "^value^": val
                );
            } else
                return val;
        } else {
            return comments + {
                "^attributes^": (
                    "xsi:type": sprintf("%s:%s", ons, type),
                ),
                "^value^": val,
            };
        }
    }

    auto deserializeValue(string en, hash<string, XsdAbstractType> tmap, *hash<auto> mrh, auto val) {
        string type;
        if (val.typeCode() == NT_HASH && (val.hasKey("^value^") || val.hasKey("^attributes^"))) {
            if (val."^attributes^"."xsi:type") {
                type = val."^attributes^"."xsi:type";
                string t = (type =~ x/[^:]+:([^:]+)/)[0];
                if (exists t) {
                    type = t;
                }

                if (name != "anyType" && type != name) {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("expecting base type %y, got %y", name, val."^attributes^"."xsi:type");
                }
            } else {
                type = name;
            }
            val = val."^value^";
        } else {
            type = name;
        }

        # issue #5411: apply "whiteSpace" processing to the lexical value
        if (val.typeCode() == NT_STRING) {
            val = XsdSimpleType::normalizeWhiteSpace(val, XsdBaseType::WhiteSpaceMap{type} ?? "collapse");
        }

        switch (type) {
            case "string":
            case "token":
            case "normalizedString":
            case "anyURI":
            case "language":
            case "Name":
            case "NCName":
            case "QName":
            case "NMTOKEN":
            case "NMTOKENS":
            case "ID":
            case "IDREF":
            case "IDREFS":
            case "ENTITY":
            case "ENTITIES":
                if (exists val && !val.strp()) {
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("type %y does not accept values of type %y (val: %y)", type, val.type(), val);
                }
                return nsc.opt_empty_string_is_nothing ? val : string(val);

            case "integer": {
                # note that we do not convert xsd:integer to a qore integer if we would lose precision
                int v = int(val);
                return v == val ? v : val;
            }

            case "byte":
                val = int(val);
                if (val < RANGE_BYTE[0] || val > RANGE_BYTE[1])
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("value %d is out of range for type %y", val, name);
                return val;

            case "short":
                val = int(val);
                if (val < RANGE_SHORT[0] || val > RANGE_SHORT[1])
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("value %d is out of range for type %y", val, name);
                return val;

            case "int":
                val = int(val);
                if (val < RANGE_INT[0] || val > RANGE_INT[1])
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("value %d is out of range for type %y", val, name);
                return val;

            case "long":
                return int(val);

            case "unsignedByte":
                val = int(val);
                if ((val & 0xff) != val)
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("value %d is out of range for type %y", val, name);
                if (val < 0)
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("type %y does not accept negative values (value supplied: %d)", name, val);
                return val;

            case "unsignedShort":
                val = int(val);
                if ((val & 0xffff) != val)
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("value %d is out of range for type %y", val, name);
                if (val < 0)
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("type %y does not accept negative values (value supplied: %d)", name, val);
                return val;

            case "unsignedInt":
                val = int(val);
                if ((val & 0xffffffff) != val)
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("value %d is out of range for type %y", val, name);
                if (val < 0)
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("type %y does not accept negative values (value supplied: %d)", name, val);
                return val;

            case "unsignedLong":
                if (val < 0)
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("type %y does not accept negative values (value supplied: %d)", name, val);
                return int(val);

            case "negativeInteger":
                if (val >= 0)
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("type %y only accepts negative values (value supplied: %d)", name, val);
                return int(val);

            case "nonNegativeInteger":
                if (val < 0)
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("type %y only accepts non-negative values (value supplied: %d)", name, val);
                return int(val);

            case "nonPositiveInteger":
                if (val > 0)
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("type %y only accepts non-positive values (value supplied: %d)", name, val);
                return int(val);

            case "positiveInteger":
                if (val <= 0)
                    throw SOAP_DESERIALIZATION_ERROR, sprintf("type %y only accepts positive values (value supplied: %d)", name, val);
                return int(val);

            case "date":
                return date(val);

            case "dateTime":
                return date(val);

            case "time":
                return date("1970-01-01T" + val);

            case "boolean":
                if (val =~ /true/i)
                    return True;
                if (val =~ /false/i)
                    return False;
                return boolean(val);

            case "decimal":
                return float(val);

            case "base64Binary":
                if (val.typeCode() == NT_BINARY) {
                    return val;
                } else {
                    return val.empty() ? binary() : parse_base64_string(val);
                }

            case "hexBinary":
                if (val.typeCode() == NT_BINARY) {
                    return val;
                } else {
                    return val.empty() ? binary() : parse_hex_string(val);
                }

            case "binary":
                # used for HTTP binding only
                if (val.typeCode() == NT_BINARY) {
                    return val;
                } else {
                    return val.empty() ? binary() : binary(val);
                }

            case "float":
            case "double":
                # Handle IEEE 754 float/double
                if (val.typeCode() == NT_STRING) {
                    switch (val) {
                        case "INF":
                            return @inf@;
                        case "-INF":
                            return -@inf@;
                        case "NaN":
                            return @nan@;
                        default:
                            return float(val);
                    }
                }
                return float(val);

            case "duration":
                # Return duration as string (ISO 8601 format)
                # Applications can parse this as needed
                if (val.typeCode() == NT_STRING) {
                    # Validate format
                    if (val !~ /^-?P(\d+Y)?(\d+M)?(\d+D)?(T(\d+H)?(\d+M)?(\d+(\.\d+)?S)?)?$/) {
                        throw SOAP_DESERIALIZATION_ERROR, sprintf("value %y is not a valid ISO 8601 duration", val);
                    }
                    # Reject empty durations: "P", "-P", "PT", "-PT"
                    if (val =~ /^-?PT?$/) {
                        throw SOAP_DESERIALIZATION_ERROR, sprintf("value %y is an empty ISO 8601 duration (missing components)", val);
                    }
                    return val;
                }
                return string(val);

            case "gYear":
                # Return gYear as string (YYYY with optional timezone)
                if (val.typeCode() == NT_STRING) {
                    # Extract year portion for validation
                    if (val !~ /^-?\d{4,}(Z|[+-]\d{2}:\d{2})?$/) {
                        throw SOAP_DESERIALIZATION_ERROR, sprintf("value %y is not a valid gYear", val);
                    }
                    return val;
                }
                return string(val);

            case "gYearMonth":
                # Return gYearMonth as string (YYYY-MM with optional timezone)
                if (val.typeCode() == NT_STRING) {
                    if (val !~ /^-?\d{4,}-\d{2}(Z|[+-]\d{2}:\d{2})?$/) {
                        throw SOAP_DESERIALIZATION_ERROR, sprintf("value %y is not a valid gYearMonth", val);
                    }
                    return val;
                }
                return string(val);

            case "gMonthDay":
                # Return gMonthDay as string (--MM-DD with optional timezone)
                if (val.typeCode() == NT_STRING) {
                    if (val !~ /^--\d{2}-\d{2}(Z|[+-]\d{2}:\d{2})?$/) {
                        throw SOAP_DESERIALIZATION_ERROR, sprintf("value %y is not a valid gMonthDay", val);
                    }
                    return val;
                }
                return string(val);

            case "gMonth":
                # Return gMonth as string (--MM with optional timezone)
                if (val.typeCode() == NT_STRING) {
                    if (val !~ /^--\d{2}(Z|[+-]\d{2}:\d{2})?$/) {
                        throw SOAP_DESERIALIZATION_ERROR, sprintf("value %y is not a valid gMonth", val);
                    }
                    return val;
                }
                return string(val);

            case "gDay":
                # Return gDay as string (---DD with optional timezone)
                if (val.typeCode() == NT_STRING) {
                    if (val !~ /^---\d{2}(Z|[+-]\d{2}:\d{2})?$/) {
                        throw SOAP_DESERIALIZATION_ERROR, sprintf("value %y is not a valid gDay", val);
                    }
                    return val;
                }
                return string(val);

            default: {
                if (name == "anyType")  {
                    *XsdAbstractType t = tmap_try_get(tmap, type);
                    if (t) {
                        return t.deserializeValue(en, tmap, mrh, val);
                    }
                }
                throw SOAP_DESERIALIZATION_ERROR, sprintf("don't know how to handle type %y", name);
            }
        }
    }

    #! maps the strict scalar types to the soft equivalents used for data provider types
    /** serialization accepts any value that can be converted to the target type, so a strict type would reject
        values that @ref WSDL::XsdBaseType::serializeValue() "XsdBaseType::serializeValue()" handles
    */
    const SoftTypeMap = {
        "int": SoftIntType,
        "float": SoftFloatType,
        "date": SoftDateType,
        "string": SoftStringType,
    };

    AbstractDataProviderType getDataProviderType() {
        # XSD booleans need a type that parses string values according to the XSD boolean lexical space; a plain
        # "softbool" would convert the string "false" to True
        if (name == "boolean") {
            return XsdBooleanType;
        }
        Type type = getDataProviderBaseType();
        return AbstractDataProviderType::get(SoftTypeMap{type.getName()} ?? type);
    }

    #! returns the %Qore type closest to the XSD type
    /** @note this returns the strict %Qore type; the data provider type returned by
        @ref WSDL::XsdBaseType::getDataProviderType() "XsdBaseType::getDataProviderType()" is a soft type, because
        serialization accepts any value convertible to the target type
    */
    Type getDataProviderBaseType() {
        switch (name) {
            case "byte":
            case "short":
            case "int":
            case "integer":
            case "long":
            case "unsignedByte":
            case "unsignedShort":
            case "unsignedInt":
            case "unsignedLong":
            case "negativeInteger":
            case "nonNegativeInteger":
            case "nonPositiveInteger":
            case "positiveInteger":
                return IntType;

            case "decimal":
            case "float":
            case "double":
                return FloatType;

            case "date":
            case "dateTime":
            case "time":
                return DateType;

            case "boolean":
                return BoolType;

            case "string":
            case "token":
            case "normalizedString":
            case "anyURI":
            case "language":
            case "Name":
            case "NCName":
            case "QName":
            case "NMTOKEN":
            case "NMTOKENS":
            case "ID":
            case "IDREF":
            case "IDREFS":
            case "ENTITY":
            case "ENTITIES":
            case "duration":
            case "gYear":
            case "gYearMonth":
            case "gMonthDay":
            case "gMonth":
            case "gDay":
                return StringType;

            case "base64Binary":
                return Base64BinaryType;

            case "hexBinary":
                return HexBinaryType;

            case "binary":
                return BinaryType;
        }

        # for anyType or any unknown type
        return AbstractDataProviderType::anyType;
    }
}

#! class for XSD array types; supports single and multi-dimensional arrays
public class XsdArrayType inherits WSDL::XsdAbstractType {
    private {
        bool finalized;
    }

    public {
        *hash<auto> typeinfo;
        XsdAbstractType elementType;

        #! number of dimensions for multi-dimensional arrays (1 = single dimension)
        int dimensions = 1;
    }

    constructor(string t, string ns, string arrayType, Namespaces nsc, XsdLateResolverHelper unresolved) : XsdAbstractType(t, ns, nsc) {
        # Parse array dimensions - handles both [] and [,] notation
        # SOAP 1.1 Section 5.4.2 supports:
        # - Single dimension: type[] or type[n]
        # - Multi-dimension: type[,] or type[n,m] (comma-separated)
        # - Nested arrays: type[][] (multiple bracket pairs)

        # Count dimensions from bracket notation using extract mode (x//)
        # Handle comma-separated dimensions first (e.g., [,] = 2D, [n,m] = 2D)
        # Note: use + not * to only match brackets with actual content
        *list<*string> match = (arrayType =~ x/\[([,\d]+)\]$/);
        if (match) {
            *string dimSpec = match[0];
            # Count commas + 1 for comma-separated dimensions (e.g., [,] = 2D, [,,] = 3D)
            # Use regex_subst to remove commas and calculate count from length difference
            string noCommas = regex_subst(dimSpec, ",", "", RE_Global);
            int commaCount = dimSpec.length() - noCommas.length();
            dimensions = commaCount + 1;
            # Remove the bracket suffix
            arrayType =~ s/\[([,\d]+)\]$//;
        }

        # Handle empty bracket pairs (e.g., type[][] = 2D, type[] = 1D)
        # Count all [] pairs and set dimensions to that count
        int bracketCount = 0;
        while (arrayType =~ /\[\]$/) {
            bracketCount++;
            arrayType =~ s/\[\]$//;
        }
        if (bracketCount > 0) {
            dimensions = bracketCount;
        }

        if (!nsc.doType(arrayType, \typeinfo, \elementType)) {
            unresolved.add(self);
        } else {
            finalized = True;
        }
    }

    AbstractDataProviderType getDataProviderType() {
        # Build nested list type for multi-dimensional arrays
        AbstractDataProviderType innerType = elementType.getDataProviderType();
        for (int i = 0; i < dimensions; i++) {
            innerType = new ListDataType(innerType);
        }
        return innerType;
    }

    finalize(hash<string, XsdAbstractType> tmap, Namespaces nsc, *hash<string, XsdGroup> groupMap,
            *hash<string, XsdAttributeGroup> attrGroupMap, *XsdLateResolverHelper unresolved) {
        if (finalized) {
            return;
        }
        finalized = True;

        XsdAbstractType t = tmap_get(tmap, typeinfo.val);
        if (t instanceof XsdComplexType) {
            cast<XsdComplexType>(t).finalize(tmap, nsc, groupMap, attrGroupMap, unresolved);

            if (!type.isRequired())
                return;

            if (!type.requiresValue())
                return ("^value^": NOTHING);

            throw SOAP_SERIALIZATION_ERROR, sprintf("missing element %y value for %s::%s (minOccurs: %d, type %y)", name, typename, key, minOccurs, type.getName());
        }

        # NOTE: pf must be an untyped hash
        hash pf;
        if ((!omitType || type != self.type) && type.hasRealName())
            pf = ("^attributes^": ("xsi:type": !usedocns ? type.getName() : type.getNameWithNS()));

        if (tc == NT_LIST) {
            # For list types (XsdSimpleType with listItemType), the list value is passed
            # directly to the type's serialize() which handles it as a space-separated value
            if (is_list_type) {
                # Let the list type handle the list value directly
                auto rv = type.serializeValue(nsc, h, omitType);
                if (!pf) {
                    return rv;
                }
                if (rv.typeCode() != NT_HASH) {
                    pf."^value^" = rv;
                    return pf;
                }
                return pf + rv;

        return type.deserializeValue(name, new hash<string, XsdAbstractType>(), NOTHING, val);
    }

    #! returns the attribute value serialized according to the attribute's type
    /** attribute values must be converted like element values; otherwise dates, booleans, and binary values are
        written to the XML message in Qore's default string representation instead of in their XSD representation

        @param nsc the namespace container for the message being serialized
        @param val the attribute value to serialize

        @return the serialized attribute value

        @since %WSDL 0.5.8
    */
    auto serializeAttributeValue(Namespaces nsc, auto val) {
        # the type is not resolved for attributes declared with a "ref" attribute
        return type ? type.serializeValue(nsc, val, True) : val;
    }
}


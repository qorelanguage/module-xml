#! helper class for XSD regular expressions
/** The XSD regular expression language (XSD 1.0 part 2 appendix F) is not PCRE, which is what %Qore uses:
    - \c "^" and \c "$" are ordinary characters in XSD; a pattern always has to match the entire value
    - XSD has the multi-character escapes \c "\i", \c "\I", \c "\c", and \c "\C" for XML name characters,
      which PCRE does not have
    - XSD character classes support subtraction (ex: \c "[a-z-[aeiou]]"), which PCRE does not support
    - \c "\s", \c "\w", and \c "\d" denote different character sets in the two languages; \c "\s" does not
      include form feed or vertical tab in XSD, while \c "\w" and \c "\d" are not limited to ASCII

    This class converts XSD regular expressions to the equivalent PCRE expressions, and generates sample values
    matching them.

    @note Unicode block names in \c "\p{IsXxx}" escapes are passed through unchanged; %Qore's regular expression
    engine supports Unicode categories and scripts, but not XSD block names

    @since %WSDL 0.5.8
*/
public class XsdRegexHelper {
    public {
        #! XML NameStartChar as used by the XSD "\i" escape (ASCII range)
        const NameStartChars = "A-Za-z_:";
        #! XML NameChar as used by the XSD "\c" escape (ASCII range)
        const NameChars = "-.0-9A-Za-z_:";
        #! the characters denoted by the XSD "\s" escape; PCRE also includes form feed and vertical tab
        const SpaceChars = " \\t\\n\\r";
        #! the character categories excluded by the XSD "\w" escape
        const NonWordCategories = "\\p{P}\\p{Z}\\p{C}";

    #! Unicode block ranges for the XSD \c "\p{IsXxx}" escapes, keyed by normalized block name
    /** generated from the Unicode character database (Blocks.txt); block names are compared ignoring
        case, whitespace, hyphens, and underscores, as the Unicode character database specifies
    */
    const UnicodeBlocks = {
        # Basic Latin
        "basiclatin":                                  '\x{0000}-\x{007F}',
        # Latin-1 Supplement
        "latin1supplement":                            '\x{0080}-\x{00FF}',
        # Latin Extended-A
        "latinextendeda":                              '\x{0100}-\x{017F}',
        # Latin Extended-B
        "latinextendedb":                              '\x{0180}-\x{024F}',
        # IPA Extensions
        "ipaextensions":                               '\x{0250}-\x{02AF}',
        # Spacing Modifier Letters
        "spacingmodifierletters":                      '\x{02B0}-\x{02FF}',
        # Combining Diacritical Marks
        "combiningdiacriticalmarks":                   '\x{0300}-\x{036F}',
        # Greek and Coptic
        "greekandcoptic":                              '\x{0370}-\x{03FF}',
        # Cyrillic
        "cyrillic":                                    '\x{0400}-\x{04FF}',
        # Cyrillic Supplement
        "cyrillicsupplement":                          '\x{0500}-\x{052F}',

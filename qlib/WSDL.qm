            "optional": True,
            "required": True,
            "prohibited": True,
        };
    }

    constructor(hash<auto> attr, Namespaces nsc, *XsdAbstractType n_type, XsdLateResolverHelper unresolved) : XsdTypedData(\attr) {
        *hash<auto> aa = attr."^attributes^";
        if (aa.type) {
